{
  "name": "dmf-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens:build": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "test:dmf-ui:tokens": "npm run build && node scripts/test-dmf-ui-tokens.mjs",
    "test:dmf-ui:content": "npm run build && node scripts/test-dmf-ui-content.mjs",
    "predev": "npm run tokens:check",
    "precheck": "npm run tokens:check",
    "prebuild": "npm run tokens:check",
    "prepack": "npm run tokens:check",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:dmf-ui": "npm run build && node scripts/test-dmf-ui.mjs",
    "test:dmf-ui:accessibility": "npm run build && node scripts/test-dmf-ui-accessibility.mjs",
    "test:dmf-ui:navigation": "npm run build:dmf-ui:navigation && node scripts/test-dmf-ui-navigation.mjs",
    "build:dmf-ui:navigation": "astro build --config tests/fixtures/navigation/astro.config.mjs",
    "preview:dmf-ui:navigation": "npm run build:dmf-ui:navigation && node scripts/preview-dmf-ui-navigation.mjs",
    "test:dmf-ui:docs": "npm run build && node scripts/test-dmf-ui-documentation.mjs",
    "test:dmf-ui:react-consumer": "node scripts/test-dmf-ui-react-consumer.mjs"
  },
  "dependencies": {
    "@data-slot/accordion": "1.1.2",
    "@data-slot/dialog": "1.1.2",
    "@data-slot/dropdown-menu": "1.1.2",
    "@data-slot/popover": "1.1.2",
    "@data-slot/radio-group": "1.1.2",
    "@data-slot/select": "1.1.2",
    "@data-slot/switch": "1.1.2",
    "@data-slot/tabs": "1.1.2",
    "@data-slot/toast": "1.1.2",
    "@data-slot/tooltip": "1.1.2",
    "@lucide/astro": "1.60.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "description": "Experimental Fulldev-based Astro UI components and DMF/CB presets",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmfeisal/dmf-ui.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/components/dmf-ui/index.ts",
    "./button": "./src/components/dmf-ui/button/index.ts",
    "./checkbox": "./src/components/dmf-ui/checkbox/index.ts",
    "./dialog": "./src/components/dmf-ui/dialog/index.ts",
    "./dropdown-menu": "./src/components/dmf-ui/dropdown-menu/index.ts",
    "./field": "./src/components/dmf-ui/field/index.ts",
    "./input": "./src/components/dmf-ui/input/index.ts",
    "./label": "./src/components/dmf-ui/label/index.ts",
    "./popover": "./src/components/dmf-ui/popover/index.ts",
    "./radio-group": "./src/components/dmf-ui/radio-group/index.ts",
    "./select": "./src/components/dmf-ui/select/index.ts",
    "./separator": "./src/components/dmf-ui/separator/index.ts",
    "./switch": "./src/components/dmf-ui/switch/index.ts",
    "./tabs": "./src/components/dmf-ui/tabs/index.ts",
    "./textarea": "./src/components/dmf-ui/textarea/index.ts",
    "./toast": "./src/components/dmf-ui/toast/index.ts",
    "./button/variants": "./src/components/dmf-ui/button/button-variants.ts",
    "./styles.css": "./src/styles/dmf-ui.css",
    "./examples.css": "./src/styles/dmf-ui-examples.css",
    "./tokens.css": "./src/styles/dmf-ui-tokens.css",
    "./presets/cb-ui.css": "./src/styles/dmf-ui-cb.css",
    "./examples/*": "./src/components/dmf-ui/examples/*.astro",
    "./notices": "./public/dmf-ui-notices.txt",
    "./package.json": "./package.json",
    "./provenance": "./docs/DMF-UI-UPSTREAM.json",
    "./accordion": "./src/components/dmf-ui/accordion/index.ts",
    "./tooltip": "./src/components/dmf-ui/tooltip/index.ts",
    "./tokens.json": "./tokens/design.tokens.json",
    "./tokens/resolved.json": "./tokens/resolved.json",
    "./text": "./src/components/dmf-ui/text/index.ts",
    "./card": "./src/components/dmf-ui/card/index.ts",
    "./badge": "./src/components/dmf-ui/badge/index.ts",
    "./alert": "./src/components/dmf-ui/alert/index.ts",
    "./contracts.json": "./contracts/components.json"
  },
  "files": [
    "contracts/*.json",
    "tokens/*.json",
    "src/components/dmf-ui",
    "src/styles/dmf-ui*.css",
    "src/assets",
    "public/dmf-ui-notices.txt",
    "README.md",
    "docs/DMF-UI-UPSTREAM.json",
    "src/styles/upstream"
  ],
  "peerDependencies": {
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  }
}
