    "./table": "./src/components/dmf-ui/table/index.ts",
    "./description-list": "./src/components/dmf-ui/description-list/index.ts",
    "./slider": "./src/components/dmf-ui/slider/index.ts",
    "./collapsible": "./src/components/dmf-ui/collapsible/index.ts",
