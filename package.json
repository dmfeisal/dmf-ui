{
  "name": "dmf-ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:dmf-ui:blocks-consumer": "node scripts/test-dmf-ui-blocks-consumer.mjs",
    "tokens:build": "node scripts/design-tokens.mjs && npm run foundations:build",
    "tokens:check": "node scripts/design-tokens.mjs --check && npm run foundations:check",
    "test:dmf-ui:tokens": "npm run build && node scripts/test-dmf-ui-tokens.mjs",
    "test:dmf-ui:content": "npm run build && node scripts/test-dmf-ui-content.mjs",
    "predev": "npm run tokens:check",
    "precheck": "npm run tokens:check && npm run upstream:check && npm run contracts:check",
    "prebuild": "npm run tokens:check",
    "prepack": "npm run tokens:check",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "test:dmf-ui": "npm run build && node scripts/test-dmf-ui.mjs",
    "test:dmf-ui:accessibility": "npm run build && node scripts/test-dmf-ui-accessibility.mjs",
    "test:dmf-ui:navigation": "npm run build:dmf-ui:navigation && node scripts/test-dmf-ui-navigation.mjs",
    "build:dmf-ui:navigation": "astro build --config tests/fixtures/navigation/astro.config.mjs",
    "preview:dmf-ui:navigation": "npm run build:dmf-ui:navigation && node scripts/preview-dmf-ui-navigation.mjs",
    "test:dmf-ui:docs": "npm run build && node scripts/test-dmf-ui-documentation.mjs",
    "test:dmf-ui:react-consumer": "node scripts/test-dmf-ui-react-consumer.mjs",
    "test:dmf-ui:react-browser": "node scripts/test-dmf-ui-react-browser.mjs",
    "upstream:check": "node scripts/import-fulldev-components.mjs",
    "foundations:build": "node scripts/foundations.mjs",
    "foundations:check": "node scripts/foundations.mjs --check",
    "contracts:build": "node scripts/component-contracts.mjs",
    "contracts:check": "node scripts/component-contracts.mjs --check"
  },
  "dependencies": {
    "@data-slot/accordion": "1.1.2",
    "@data-slot/command": "1.1.2",
    "@data-slot/core": "1.1.2",
    "@data-slot/dialog": "1.1.2",
    "@data-slot/drawer": "1.1.2",
    "@data-slot/dropdown-menu": "1.1.2",
    "@data-slot/hover-card": "1.1.2",
    "@data-slot/popover": "1.1.2",
    "@data-slot/radio-group": "1.1.2",
    "@data-slot/resizable": "1.1.2",
    "@data-slot/select": "1.1.2",
    "@data-slot/switch": "1.1.2",
    "@data-slot/tabs": "1.1.2",
    "@data-slot/toast": "1.1.2",
    "@data-slot/tooltip": "1.1.2",
    "@lexingtonthemes/seo": "0.4.0",
    "@lucide/astro": "1.60.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "simple-icons": "16.33.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "description": "Experimental Fulldev-based Astro UI components and DMF/CB presets",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmfeisal/dmf-ui.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
