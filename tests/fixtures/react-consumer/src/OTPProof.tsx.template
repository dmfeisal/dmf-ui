import {useEffect,useRef,useState} from 'react';
import {OTPVerificationBlock,Button,Input} from '@dmf-ui/react';
export function OTPProof(){
 const form=useRef<HTMLFormElement>(null),resend=useRef<HTMLFormElement>(null),[ready,setReady]=useState(false),[state,setState]=useState<'unverified'|'ready'|'expired'|'locked'>('unverified'),[pending,setPending]=useState(false),[resending,setResending]=useState(false),[complete,setComplete]=useState(false),[error,setError]=useState(''),[resendDisabled,setResendDisabled]=useState(false);
 const previous=useRef({state,complete,resending});
 useEffect(()=>{setReady(true);},[]);
 useEffect(()=>{const old=previous.current;previous.current={state,complete,resending};if((old.state!==state||old.complete!==complete)&&(state!=='ready'||complete))form.current?.querySelector<HTMLElement>('[data-otp-status]')?.focus();else if(old.resending&&!resending&&state==='ready'&&!complete)form.current?.querySelector<HTMLInputElement>('input[name=code]')?.focus();},[state,complete,resending]);
 function show(next:typeof state){setState(next);setPending(false);setResending(false);setComplete(false);setError('');}
 return <main className="consumer-shell"><h1>OTP entry and resend UI</h1><p>Local presentation only. No code or challenge is generated, delivered, read or verified. Every real request must be authorized by the server.</p>
 <OTPVerificationBlock id="packed-otp" action="/account/verify" ref={form} challengeState={state} complete={complete} pending={pending} resendPending={resending} submitDisabled={!ready} resendDisabled={!ready||resendDisabled} resendAction="/account/resend" resendFormRef={resend} resendHelp="The server decides eligibility; no countdown is generated." resendStatus="Local preview only; no code was sent." error={error} fieldErrors={error?{code:'Illustrative host verification feedback'}:undefined} submitLabel="Verify the code for your account" fields={<Input type="hidden" name="verifyContext" value="preview-verification"/>} resendFields={<Input type="hidden" name="resendContext" value="preview-resend"/>} onSubmit={e=>{e.preventDefault();setPending(true);setError('');}} onResendSubmit={e=>{e.preventDefault();form.current?.reset();setResending(true);setError('');}}/>
 <div className="consumer-actions otp-proof-actions"><Button variant="outline" disabled={!ready} onClick={()=>show('ready')}>Show ready UI</Button><Button variant="outline" disabled={!ready} onClick={()=>show('expired')}>Show expired UI</Button><Button variant="outline" disabled={!ready} onClick={()=>show('locked')}>Show locked UI</Button><Button variant="outline" disabled={!ready} onClick={()=>show('unverified')}>Show unverified UI</Button><Button variant="outline" disabled={!ready} onClick={()=>{if(resending){setState('ready');setResending(false);}else if(pending){setPending(false);setComplete(true);}}}>Finish local preview</Button><Button variant="outline" disabled={!ready} onClick={()=>{setPending(false);setResending(false);setError('Local request could not complete.');}}>Show host error</Button><Button variant="outline" disabled={!ready} onClick={()=>{form.current?.reset();setError('');setPending(false);setResending(false);}}>Reset fields</Button><Button variant="outline" disabled={!ready} onClick={()=>setResendDisabled(!resendDisabled)}>Toggle resend eligibility</Button></div>
 </main>;
}
