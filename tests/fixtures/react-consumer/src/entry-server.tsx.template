import {StrictMode} from 'react';
import {renderToString} from 'react-dom/server';
import {App} from './App';
import {identifierPrefix} from './config';
import {SignInProof} from './SignInProof';
export function renderSignIn(){return renderToString(<StrictMode><SignInProof/></StrictMode>,{identifierPrefix:'signin-'});}
export {SignInProof};
import {HeroProof} from './HeroProof';
export function renderHero(){return renderToString(<StrictMode><HeroProof/></StrictMode>,{identifierPrefix:'hero-'});}
export {HeroProof};
export function render(initialPreset:'dmf'|'cb-ui'='dmf'){
 return renderToString(<StrictMode><App initialPreset={initialPreset}/></StrictMode>,{identifierPrefix});
}
export {App,identifierPrefix};
