import {createRef} from 'react';
import {Button,Input,Switch,Text,Card,Badge,Alert,AlertTitle,AlertDescription,AlertAction,Label,Textarea,Checkbox,Separator} from '@dmf-ui/react';
const input=createRef<HTMLInputElement>();
const button=createRef<HTMLButtonElement>();
const heading=createRef<HTMLHeadingElement>();
const card=createRef<HTMLDivElement>();
const valid=<Card ref={card}><Text as="h2" ref={heading}>Typed form</Text><Input ref={input} name="name" readOnly value="DMF"/><Switch ref={input} defaultChecked>Updates</Switch><Button ref={button} type="submit">Save</Button></Card>;
// Invalid variants and element-specific refs must fail in an external TypeScript host.
// @ts-expect-error Button has no invented variant.
const variant=<Button variant="invented"/>;
// @ts-expect-error Input ref must refer to an input element.
const invalidRef=<Input ref={button}/>;
// @ts-expect-error Switch is a native checkbox, without a read-only contract.
const readonlySwitch=<Switch readOnly>Updates</Switch>;
// @ts-expect-error The button primitive does not implement anchor navigation.
const href=<Button href="/docs/">Docs</Button>;
void [valid,variant,invalidRef,readonlySwitch,href];

const content=<Alert ref={card} role="status"><AlertTitle ref={card}>Preview</AlertTitle><AlertDescription ref={card}>Local content</AlertDescription><AlertAction ref={card}><Badge as="a" href="#content-proof" ref={createRef<HTMLAnchorElement>()}>Details</Badge><Badge ref={createRef<HTMLSpanElement>()}>Draft</Badge></AlertAction></Alert>;
// @ts-expect-error Anchor badges require a destination.
const missingDestination=<Badge as="a">Details</Badge>;
// @ts-expect-error Static badges cannot navigate.
const staticDestination=<Badge href="/">Details</Badge>;
// @ts-expect-error Badge anchor refs must be anchors.
const wrongBadgeRef=<Badge as="a" href="/" ref={button}>Details</Badge>;
// @ts-expect-error Alert has no invented variant.
const wrongAlert=<Alert variant="warning"/>;
void [content,missingDestination,staticDestination,wrongBadgeRef,wrongAlert];

const basics=<><Label ref={createRef<HTMLLabelElement>()} htmlFor="notes">Notes</Label><Textarea ref={createRef<HTMLTextAreaElement>()} id="notes" defaultValue="Local"/><Checkbox ref={input} defaultChecked/><Separator ref={card} decorative={false} orientation="vertical"/></>;
// @ts-expect-error Checkbox always uses its native checkbox type.
const checkboxType=<Checkbox type="radio"/>;
// @ts-expect-error Textarea refs must be textarea elements.
const textareaRef=<Textarea ref={input}/>;
// @ts-expect-error Separator is not an adjustable focusable widget.
const separatorFocus=<Separator tabIndex={0}/>;
// @ts-expect-error Checkbox readOnly does not prevent native toggling.
const readonlyCheckbox=<Checkbox readOnly/>;
void [basics,checkboxType,textareaRef,separatorFocus,readonlyCheckbox];
