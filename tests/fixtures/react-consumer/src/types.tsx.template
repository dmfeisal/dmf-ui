import {createRef} from 'react';
import {SignInBlock} from '@dmf-ui/react';
import {HeroBlock} from '@dmf-ui/react';
import {MerchantListingBlock} from '@dmf-ui/react';
const listing=<MerchantListingBlock id="results" title="Results" items={[{slug:'a'}]} getItemKey={item=>item.slug} renderItem={item=><p>{item.slug}</p>} ref={createRef<HTMLElement>()}/>;
// @ts-expect-error Item key must be a stable string.
const numericListingKey=<MerchantListingBlock id="results" title="Results" items={[{id:1}]} getItemKey={item=>item.id} renderItem={item=><p>{item.id}</p>}/>;
// @ts-expect-error Item rendering is required.
const missingListingRenderer=<MerchantListingBlock id="results" title="Results" items={[]} getItemKey={()=>'a'}/>;
// @ts-expect-error Empty is derived from ready items, not a status value.
const emptyListingStatus=<MerchantListingBlock id="results" title="Results" items={[]} getItemKey={()=>'a'} renderItem={()=>null} status="empty"/>;
void [listing,numericListingKey,missingListingRenderer,emptyListingStatus];
const hero=<HeroBlock id="intro" title="Page title" ref={createRef<HTMLElement>()} media={<img src="/media.svg" alt="Authored alternative"/>}/>;
// @ts-expect-error A Hero needs a title.
const missingHeroTitle=<HeroBlock id="intro"/>;
// @ts-expect-error Hero supports only centered and split layouts.
const unsupportedHeroLayout=<HeroBlock id="intro" title="Title" layout="carousel"/>;
// @ts-expect-error Native section refs cannot point to an SVG.
const wrongHeroRef=<HeroBlock id="intro" title="Title" ref={createRef<SVGSVGElement>()}/>;
void [hero,missingHeroTitle,unsupportedHeroLayout,wrongHeroRef];
const signIn=<SignInBlock id="account" action="/account" ref={createRef<HTMLFormElement>()} onSubmit={e=>e.preventDefault()} fields={<input name="scope"/>}/>;
// @ts-expect-error Native form method is fixed to POST.
const signInMethod=<SignInBlock id="account" action="/account" method="get"/>;
// @ts-expect-error Sign-in ref is a form, not an input.
const signInRef=<SignInBlock id="account" action="/account" ref={createRef<HTMLInputElement>()}/>;
// @ts-expect-error No authored initial password is accepted.
const signInPassword=<SignInBlock id="account" action="/account" password="secret"/>;
// @ts-expect-error Host action is required.
const signInAction=<SignInBlock id="account"/>;
void [signIn,signInMethod,signInRef,signInPassword,signInAction];
import {Button,Input,Switch,Text,Card,Badge,Alert,AlertTitle,AlertDescription,AlertAction,Label,Textarea,Checkbox,Separator,CardTitle,Field,FieldSet,FieldLegend,FieldDescription,FieldLabel,RadioGroup,RadioGroupItem,Select,SelectOption,SelectGroup} from '@dmf-ui/react';
const input=createRef<HTMLInputElement>();
const button=createRef<HTMLButtonElement>();
const heading=createRef<HTMLHeadingElement>();
const card=createRef<HTMLDivElement>();
const valid=<Card ref={card}><Text as="h2" ref={heading}>Typed form</Text><Input ref={input} name="name" readOnly value="DMF"/><Switch ref={input} defaultChecked>Updates</Switch><Button ref={button} type="submit">Save</Button></Card>;
// Invalid variants and element-specific refs must fail in an external TypeScript host.
// @ts-expect-error Button has no invented variant.
const variant=<Button variant="invented"/>;
// @ts-expect-error Input ref must refer to an input element.
const invalidRef=<Input ref={button}/>;
// @ts-expect-error Switch is a native checkbox, without a read-only contract.
const readonlySwitch=<Switch readOnly>Updates</Switch>;
// @ts-expect-error The button primitive does not implement anchor navigation.
const href=<Button href="/docs/">Docs</Button>;
void [valid,variant,invalidRef,readonlySwitch,href];

const content=<Alert ref={card} role="status"><AlertTitle ref={card}>Preview</AlertTitle><AlertDescription ref={card}>Local content</AlertDescription><AlertAction ref={card}><Badge as="a" href="#content-proof" ref={createRef<HTMLAnchorElement>()}>Details</Badge><Badge ref={createRef<HTMLSpanElement>()}>Draft</Badge></AlertAction></Alert>;
// @ts-expect-error Anchor badges require a destination.
const missingDestination=<Badge as="a">Details</Badge>;
// @ts-expect-error Static badges cannot navigate.
const staticDestination=<Badge href="/">Details</Badge>;
// @ts-expect-error Badge anchor refs must be anchors.
const wrongBadgeRef=<Badge as="a" href="/" ref={button}>Details</Badge>;
// @ts-expect-error Alert has no invented variant.
const wrongAlert=<Alert variant="warning"/>;
void [content,missingDestination,staticDestination,wrongBadgeRef,wrongAlert];

const basics=<><Label ref={createRef<HTMLLabelElement>()} htmlFor="notes">Notes</Label><Textarea ref={createRef<HTMLTextAreaElement>()} id="notes" defaultValue="Local"/><Checkbox ref={input} defaultChecked/><Separator ref={card} decorative={false} orientation="vertical"/></>;
// @ts-expect-error Checkbox always uses its native checkbox type.
const checkboxType=<Checkbox type="radio"/>;
// @ts-expect-error Textarea refs must be textarea elements.
const textareaRef=<Textarea ref={input}/>;
// @ts-expect-error Separator is not an adjustable focusable widget.
const separatorFocus=<Separator tabIndex={0}/>;
// @ts-expect-error Checkbox readOnly does not prevent native toggling.
const readonlyCheckbox=<Checkbox readOnly/>;
void [basics,checkboxType,textareaRef,separatorFocus,readonlyCheckbox];

const composed=<FieldSet ref={createRef<HTMLFieldSetElement>()} disabled><FieldLegend ref={createRef<HTMLLegendElement>()}>Group</FieldLegend><Field orientation="responsive"><FieldLabel htmlFor="field-notes">Notes</FieldLabel><FieldDescription ref={createRef<HTMLParagraphElement>()}>Help</FieldDescription><CardTitle as="h3" ref={heading}>Section</CardTitle></Field></FieldSet>;
// @ts-expect-error Field orientation has a bounded contract.
const fieldOrientation=<Field orientation="diagonal"/>;
// @ts-expect-error FieldSet is a native fieldset, not a generic div.
const fieldsetRef=<FieldSet ref={card}/>;
// @ts-expect-error CardTitle does not implement links.
const cardTitleLink=<CardTitle as="a" href="/">Title</CardTitle>;
void [composed,fieldOrientation,fieldsetRef,cardTitleLink];

const choices=<><RadioGroup name="frequency" value="weekly" onValueChange={()=>{}} ref={createRef<HTMLFieldSetElement>()}><RadioGroupItem value="weekly" ref={input}/></RadioGroup><Select multiple defaultValue={['email']} ref={createRef<HTMLSelectElement>()}><SelectGroup label="Channels" ref={createRef<HTMLOptGroupElement>()}><SelectOption value="email" ref={createRef<HTMLOptionElement>()}>Email</SelectOption></SelectGroup></Select></>;
// @ts-expect-error Controlled groups require a change callback.
const lockedRadio=<RadioGroup value="weekly"/>;
// @ts-expect-error Item checked state belongs to its group.
const itemChecked=<RadioGroupItem value="weekly" checked/>;
// @ts-expect-error Select uses native select refs.
const wrongSelectRef=<Select ref={input}/>;
// @ts-expect-error Optgroups require authored labels.
const unnamedOptions=<SelectGroup/>;
void [choices,lockedRadio,itemChecked,wrongSelectRef,unnamedOptions];

const mediumButton=<Button size="md">Medium alias</Button>;
// @ts-expect-error XL is not a supported Button size.
const unsupportedButtonSize=<Button size="xl"/>;
void [mediumButton,unsupportedButtonSize];
