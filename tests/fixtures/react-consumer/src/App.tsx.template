import {useEffect,useId,useRef,useState} from 'react';
import {Button,Card,Input,Switch,Text,Badge,Alert,AlertTitle,AlertDescription,AlertAction,Label,Textarea,Checkbox,Separator,CardHeader,CardTitle,CardDescription,CardAction,CardContent,CardFooter,Field,FieldGroup,FieldContent,FieldLabel,FieldTitle,FieldDescription,FieldError,FieldSet,FieldLegend,FieldSeparator,RadioGroup,RadioGroupItem,Select,SelectOption,SelectGroup} from '@dmf-ui/react';
export function App({initialPreset='dmf'}:{initialPreset?:'dmf'|'cb-ui'}){
 const [preset,setPreset]=useState<'dmf'|'cb-ui'>(initialPreset);
 const [ready,setReady]=useState(false);
 const id=useId();
 useEffect(()=>setReady(true),[]);
 const [dark,setDark]=useState(false);
 const [name,setName]=useState('Feisal');
 const [updates,setUpdates]=useState(false);
 const [result,setResult]=useState('No values submitted.');
 const [delivery,setDelivery]=useState('weekly');
 const [channel,setChannel]=useState('');
 const [choiceResult,setChoiceResult]=useState('No selection preview yet.');
 const [attempted,setAttempted]=useState(false);
 const [notes,setNotes]=useState('');
 const [accepted,setAccepted]=useState(false);
 const [basicResult,setBasicResult]=useState('No form preview yet.');
 const input=useRef<HTMLInputElement>(null);
 return <main className="consumer-shell dmf-ui" data-system={preset} data-color-mode={preset==='cb-ui'?'light':undefined}>
  <h1>React consumer proof</h1>
  <Text tone="muted">Installed from packed packages. Preview values stay on this page.</Text>
  <div className="consumer-actions">
   <Button disabled={!ready} variant="outline" aria-pressed={preset==='dmf'} onClick={()=>setPreset('dmf')}>DMF preset</Button>
   <Button disabled={!ready} variant="outline" aria-pressed={preset==='cb-ui'} onClick={()=>setPreset('cb-ui')}>CB UI preset</Button>
   <Button disabled={!ready} variant="outline" aria-pressed={dark} onClick={()=>{setDark(!dark);document.documentElement.dataset.theme=dark?'light':'dark';}}>Dark surroundings</Button>
  </div>
  <Card>
   <CardHeader>
    <CardTitle as="h2" id={`${id}-title`}>Local preferences</CardTitle>
    <CardDescription>Preview form values without sending them anywhere.</CardDescription>
    <CardAction><Badge variant="secondary">Local</Badge></CardAction>
   </CardHeader>
   <CardContent>
   <form onSubmit={event=>{event.preventDefault();setResult(JSON.stringify(Object.fromEntries(new FormData(event.currentTarget))));}} onReset={()=>{setName('Feisal');setUpdates(false);setResult('Form reset.');}}>
    <fieldset disabled={!ready} aria-labelledby={`${id}-title`}>
    <Label htmlFor={`${id}-name`}>Display name</Label>
    <Input ref={input} id={`${id}-name`} name="name" required value={name} onChange={event=>setName(event.currentTarget.value)}/>
    <Switch name="updates" value="enabled" checked={updates} onChange={event=>setUpdates(event.currentTarget.checked)}>Enable updates</Switch>
    <Switch name="digest" defaultChecked>Weekly digest</Switch>
    <Switch name="disabled" defaultChecked disabled>Unavailable preference</Switch>
    <Switch name="consent" required>Required consent</Switch>
    <div className="consumer-actions"><Button type="submit">Preview values</Button><Button type="reset" variant="outline">Reset form</Button><Button variant="ghost" onClick={()=>input.current?.focus()}>Focus display name</Button></div>
    </fieldset>
   </form>
   </CardContent>
   <CardFooter><Text role="status" size="sm">{result}</Text></CardFooter>
  </Card>
  <section id={`${id}-content-proof`} aria-labelledby={`${id}-content-title`}>
   <Text as="h2" id={`${id}-content-title`} size="title">Content components</Text>
   <div className="consumer-actions">
    <Badge>Default label</Badge><Badge variant="secondary">Secondary label</Badge>
    <Badge variant="destructive">Destructive label</Badge><Badge variant="outline">Outline label</Badge>
    <Badge variant="ghost">Ghost label</Badge><Badge as="a" href={`#${id}-name`} variant="link">Display name field</Badge>
   </div>
   <Alert aria-labelledby={`${id}-notice-title`}>
    <AlertTitle id={`${id}-notice-title`}>Local preview only</AlertTitle>
    <AlertDescription>Values stay on this page. Nothing is sent to a server.</AlertDescription>
    <AlertAction><Badge as="a" variant="link" href={`#${id}-name`}>Review display name</Badge></AlertAction>
   </Alert>
   <Alert variant="destructive">
    <AlertTitle>Example validation message</AlertTitle>
    <AlertDescription>This static example shows an authored error. Complete the required consent field before previewing values.</AlertDescription>
   </Alert>
  </section>
  <Separator/>
  <section aria-labelledby={`${id}-basic-title`}>
   <Text as="h2" id={`${id}-basic-title`} size="title">Native form controls</Text>
   <form data-basic-controls onInvalid={()=>setAttempted(true)} onSubmit={event=>{event.preventDefault();setBasicResult(JSON.stringify(Object.fromEntries(new FormData(event.currentTarget))));}} onReset={()=>{setNotes('');setAccepted(false);setAttempted(false);setBasicResult('Basic form reset.');}}>
    <FieldSet disabled={!ready}>
     <FieldLegend>Local form values</FieldLegend>
     <FieldGroup>
      <Field data-invalid={attempted&&notes.length===0||undefined}>
       <FieldLabel htmlFor={`${id}-notes`}>Preview notes</FieldLabel>
       <FieldContent>
        <Textarea id={`${id}-notes`} name="notes" value={notes} onChange={event=>setNotes(event.currentTarget.value)} required aria-invalid={attempted&&notes.length===0||undefined} aria-describedby={`${id}-notes-help${attempted&&notes.length===0?' '+id+'-notes-error':''}`}/>
        <FieldDescription id={`${id}-notes-help`}>Local sample form. Notes are not sent anywhere.</FieldDescription>
        <FieldError id={`${id}-notes-error`} errors={attempted&&notes.length===0?[{message:'Enter preview notes.'}]:[]}/>
       </FieldContent>
      </Field>
      <Field orientation="horizontal">
       <Checkbox className="mt-[15px]!" id={`${id}-accepted`} name="accepted" checked={accepted} onChange={event=>setAccepted(event.currentTarget.checked)} required/>
       <FieldContent><FieldLabel className="consumer-check-label" htmlFor={`${id}-accepted`}>Confirm this local preview</FieldLabel><FieldDescription>Required for this local example.</FieldDescription></FieldContent>
      </Field>
      <FieldSeparator>Optional settings</FieldSeparator>
      <Field orientation="responsive"><FieldLabel className="consumer-check-label" htmlFor={`${id}-extras`}>Include optional details</FieldLabel><Checkbox className="@md/field-group:mt-[15px]!" id={`${id}-extras`} name="extras" defaultChecked/></Field>
      <Field data-disabled="true"><FieldTitle>Availability</FieldTitle><Label className="consumer-check-label"><Checkbox name="unavailable" disabled defaultChecked/>Unavailable option</Label></Field>
     </FieldGroup>
     <div className="consumer-actions"><Button type="submit">Preview notes</Button><Button type="reset" variant="outline">Reset notes</Button></div>
    </FieldSet>
   </form>
   <Text data-basic-result size="sm">{basicResult}</Text>
   <Separator decorative={false} aria-label="End of native form example"/>
  </section>
  <Separator/>
  <section aria-labelledby={`${id}-choice-title`}>
   <Text as="h2" id={`${id}-choice-title`} size="title">Selection controls</Text>
   <form data-choice-controls onSubmit={event=>{event.preventDefault();setChoiceResult(JSON.stringify(Object.fromEntries(new FormData(event.currentTarget))));}} onReset={()=>{setDelivery('weekly');setChannel('');setChoiceResult('Selections reset.');}}>
    <FieldSet disabled={!ready}>
     <FieldLegend>Local delivery settings</FieldLegend>
     <RadioGroup name="delivery" value={delivery} onValueChange={setDelivery} required>
      <FieldLegend variant="label">Delivery frequency</FieldLegend>
      <Label className="consumer-check-label"><RadioGroupItem value="weekly"/>Weekly</Label>
      <Label className="consumer-check-label"><RadioGroupItem value="unavailable" disabled/>Unavailable frequency</Label>
      <Label className="consumer-check-label"><RadioGroupItem value="monthly"/>Monthly</Label>
     </RadioGroup>
     <RadioGroup name="format" defaultValue="summary">
      <FieldLegend variant="label">Message format</FieldLegend>
      <Label className="consumer-check-label"><RadioGroupItem value="summary"/>Summary</Label>
      <Label className="consumer-check-label"><RadioGroupItem value="full"/>Full details</Label>
     </RadioGroup>
     <Field><FieldLabel htmlFor={`${id}-channel`}>Delivery channel</FieldLabel><Select id={`${id}-channel`} name="channel" value={channel} onChange={event=>setChannel(event.currentTarget.value)} required>
      <SelectOption value="" disabled>Choose a channel</SelectOption>
      <SelectGroup label="Available channels"><SelectOption value="email">Email</SelectOption><SelectOption value="digest">Digest</SelectOption></SelectGroup>
      <SelectGroup label="Unavailable channels" disabled><SelectOption value="sms">SMS (unavailable)</SelectOption></SelectGroup>
     </Select></Field>
     <div className="consumer-actions"><Button type="submit">Preview selections</Button><Button type="reset" variant="outline">Reset selections</Button></div>
    </FieldSet>
   </form>
   <Text data-choice-result size="sm">{choiceResult}</Text>
  </section>
 </main>;
}
