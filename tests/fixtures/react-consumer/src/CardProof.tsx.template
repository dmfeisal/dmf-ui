import {MerchantCard,MerchantListingBlock} from '@dmf-ui/react';
export const icons={verified:'/merchant-card/verified.svg',hours:'/merchant-card/hours.svg',distance:'/merchant-card/distance.svg',star:'/merchant-card/star.svg'};
export const reference={name:'Rush Hour Kelapa Gading',href:'#details',verified:true,statusText:'Opens till 22:00',statusTone:'open' as const,distanceText:'0.5 Km',priceLevel:2 as const,cuisines:'Steak, Argentinian',address:'Jl. Boulevard Kelapa Gading no. 34, Kelapa Gading Bagus',rating:4.8,reviewCount:1235,locale:'id-ID',photos:[1,2,3].map(n=>({src:`/merchant-card/photo-${n}.png`,alt:`Supplied reference photo ${n}`}))};
export function CardProof(){return <main className="dmf-ui consumer-shell" data-system="hui" data-color-mode="light" style={{fontSize:'1rem'}}><h1>Merchant card proof</h1><p>Authored reference content, not live merchant information.</p><div style={{width:328,maxWidth:'100%'}}><MerchantCard headingLevel="h2" id="reference-card" {...reference} icons={icons}/></div><MerchantListingBlock id="card-list" title="Card integration" items={[reference]} getItemKey={()=>'reference'} renderItem={item=><MerchantCard id="listed-card" {...item} icons={icons}/>}/><MerchantCard id="empty-card" name="Sample without photos" href="#details" photos={[]} icons={icons}/><div style={{width:328,maxWidth:'100%'}}><MerchantCard id="long-card" {...reference} name="A long authored merchant name that wraps without hiding its destination" reviewCount={12345678} locale="ar" icons={icons}/></div><section id="details"><h2>Reference destination</h2><p>No merchant service is connected.</p></section></main>;}
