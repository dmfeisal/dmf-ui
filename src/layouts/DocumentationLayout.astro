---
import '../styles/documentation.css';
import {components,guides,categories} from '../data/documentation';
interface Props { title:string;description:string;section:'home'|'components'|'docs'|'create';crumbs?:{name:string;href?:string}[];toc?:{id:string;title:string}[]; }
const {title,description,section,crumbs=[],toc=[]}=Astro.props;
const sidebar=section==='components'?components.map(item=>({title:item.name,href:`/components/${item.slug}/`})) : section==='docs'?guides.map(item=>({title:item.title,href:`/docs/${item.slug}/`})) : [];
const sidebarGroups=section==='components'?categories.map(title=>({title,items:components.filter(item=>item.category===title).map(item=>({title:item.name,href:`/components/${item.slug}/`}))})):[{title:'Guides',items:sidebar}];
const searchEntries=[
 ...components.map(item=>({title:item.name,description:item.description,href:`/components/${item.slug}/`,group:'Components',keywords:`${item.category} ${item.slug}`})),
 ...guides.map(item=>({title:item.title,description:item.description,href:`/docs/${item.slug}/`,group:'Guides',keywords:item.sections.map(part=>part.title).join(' ')})),
 {title:'Create a preset',description:'Configure colors, typography, radius and product presets.',href:'/create/',group:'Pages',keywords:'CB UI reconstruction foundation theme export CSS JSON'},
];

---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title==='DMF UI'?title:`${title} · DMF UI`}</title></head>
<body class="dmf-ui docs-shell">
<a href="#main" class="docs-skip">Skip to content</a>
<header class="docs-header"><div class="docs-header-inner">
<a href="/" class="docs-logo" aria-label="DMF UI Home">DMF UI</a>
<nav aria-label="Primary" class="docs-primary">{[['home','Home','/'],['components','Components','/components/'],['docs','Docs','/docs/'],['create','Create','/create/']].map(([key,label,href])=><a href={href} aria-current={section===key?'page':undefined}>{label}</a>)}</nav>
<a class="docs-search-fallback" href="/components/">Find components</a>
<button id="docs-search-trigger" type="button" class="docs-search-trigger" aria-label="Search documentation" aria-haspopup="dialog" hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>Search documentation</span><kbd aria-hidden="true">Ctrl K</kbd></button>
<button id="docs-theme" type="button" class="docs-theme">Theme: System</button>
</div>{crumbs.length>0&&<nav class="docs-breadcrumb" aria-label="Breadcrumb"><ol><li><a href={Astro.url.pathname.split('/').filter(Boolean).map(()=>'..').join('/')+'/'}>Home</a></li>{crumbs.map(crumb=><li>{crumb.href?<a href={crumb.href}>{crumb.name}</a>:<span aria-current="page">{crumb.name}</span>}</li>)}</ol></nav>}</header>
<div class:list={['docs-layout',{'docs-has-sidebar':sidebar.length>0,'docs-has-toc':toc.length>0}]}>
{sidebar.length>0&&<aside class="docs-sidebar" aria-label={section==='components'?'Component list':'Guide list'}><nav aria-label={section==='components'?'Component navigation':'Documentation navigation'}>{sidebarGroups.map(group=><div class="docs-nav-group"><p class="docs-nav-title">{group.title}</p>{group.items.map(item=><a href={item.href} aria-current={Astro.url.pathname===item.href?'page':undefined}>{item.title}</a>)}</div>)}</nav></aside>}
{sidebar.length>0&&<details class="docs-mobile-navigation"><summary>Browse {section==='components'?'components':'documentation'}</summary><nav aria-label="Section navigation">{sidebar.map(item=><a href={item.href} aria-current={Astro.url.pathname===item.href?'page':undefined}>{item.title}</a>)}</nav></details>}
<main id="main" class="docs-page" tabindex="-1"><slot /></main>
{toc.length>0&&<aside class="docs-toc" aria-label="Page contents"><nav aria-label="On this page"><p class="docs-nav-title">On this page</p>{toc.map(item=><a href={`#${item.id}`}>{item.title}</a>)}</nav></aside>}
</div>
<footer class="docs-footer"><span>DMF UI · Experimental Astro foundation</span><nav aria-label="Project links"><a href="/docs/credits/">Credits</a><a href="/dmf-ui-notices.txt">License notices</a><a href="https://github.com/dmfeisal/dmf-ui">GitHub</a></nav></footer>
<dialog id="docs-search-dialog" class="docs-search-dialog" aria-labelledby="docs-search-title" aria-describedby="docs-search-help">
<div class="docs-search-dialog-heading"><h2 id="docs-search-title">Search documentation</h2><button type="button" data-search-close>Close <kbd>Esc</kbd></button></div>
<div class="docs-search-input-shell"><input id="docs-search-input" type="search" aria-label="Search components and guides" placeholder="Component, guide, or purpose…" autocomplete="off" aria-controls="docs-search-results"/></div>
<p id="docs-search-count" class="docs-search-count" role="status" aria-live="polite"></p>
<nav id="docs-search-results" aria-label="Search results"></nav>
<p id="docs-search-help">Use ↑ ↓ to move, Enter to open, and Esc to close.</p>
</dialog>
<script id="docs-search-index" type="application/json" set:html={JSON.stringify(searchEntries).replaceAll('<',String.fromCharCode(92)+'u003c')}/>
</body></html>
<script>import '../scripts/documentation';</script>
