---
import NavigationIcon from './NavigationIcon.astro';
import source from '../../../tokens/foundations.json';
import brands from '../../../contracts/brands.json';
import {Button} from '../dmf-ui/button';
import {Card,CardContent} from '../dmf-ui/card';
import {Search,ArrowRight} from '@lucide/astro';
interface Props {slug:string;}
const {slug}=Astro.props;
const category=slug.replace('foundation-','');
const entries=Object.entries(source.tokens).filter(([,t])=>t.category===category||(category==='radius'&&t.category==='borders'));
const links=[['colors','Colors'],['typography','Typography'],['spacing','Spacing'],['layout','Layout & grid'],['radius','Borders & radius'],['elevation','Elevation & layers'],['motion','Motion'],['iconography','Iconography'],['accessibility','Accessibility']];
---
{slug==='foundations'?<nav class="foundation-index" aria-label="Foundation topics">{links.map(([key,title])=><a href={`/docs/foundation-${key}/`}><NavigationIcon name={`foundation-${key}`} size={20}/><span>{title}</span><ArrowRight size={16} aria-hidden="true"/></a>)}</nav>:<div class="foundation-examples">
{category==='colors'&&<><h2>Readable semantic pairs</h2><div class="foundation-pairs">{['dmf','cb-ui','hui','qdi','portfolio'].map(system=><section class="dmf-ui foundation-pair" data-system={system} data-color-mode="light" aria-label={`${system} color specimen`}><h3>{{dmf:'DMF','cb-ui':'CB',hui:'HUI',qdi:'QDI',portfolio:'Portfolio'}[system]}</h3><Button>Primary action</Button><Button variant="secondary">Secondary action</Button><Card><CardContent>Surface and text inherit their preset.</CardContent></Card></section>)}</div><p class="docs-note">Brand swatches are reference values. Use tested semantic pairs for text. Inspect QDI’s complete palette in the brand mapping reference.</p></>}
{category==='typography'&&<div class="foundation-type">{Object.entries(source.tokens).filter(([key])=>key.startsWith('type-')).map(([key,t])=><p style={`font-size:var(--dmf-${key});line-height:var(--dmf-leading-body)`}><span>{key} · {t.value}</span>Readable type, at your size.</p>)}</div>}
{category==='spacing'&&<><ul class="foundation-rulers">{Object.entries(source.tokens).filter(([key])=>key.startsWith('space-')).map(([key,t])=><li><code>{key} · {t.value}</code><span style={`inline-size:var(--dmf-${key});`} aria-hidden="true"/></li>)}</ul><h2>Shared control sizing</h2><p>Nova keeps 24/28/32/36px control heights at a 16px reference root. Button aliases consume these primitives; width stays independent. No mobile breakpoint changes them automatically. The earlier 40/48/56px proposal is deferred to an explicit comfortable profile.</p><div class="docs-table-scroll"><table class="docs-options"><thead><tr><th>Token</th><th>Value</th></tr></thead><tbody>{Object.entries(source.tokens).filter(([key])=>key.startsWith('control-height-')||key.startsWith('button-height')).map(([key,t])=><tr><td><code>--dmf-{key}</code></td><td><code>{t.value}</code></td></tr>)}</tbody></table></div></>}
{category==='layout'&&<><label class="foundation-label" for="foundation-columns">Grid columns</label><select id="foundation-columns" data-foundation-columns><option value="2">2 columns</option><option value="3" selected>3 columns</option><option value="4">4 columns</option></select><div class="foundation-grid" data-foundation-grid>{Array.from({length:12},(_,i)=><div>{i+1}</div>)}</div><p class="docs-note">The grid becomes one column on narrow screens. Column controls are a layout demonstration, not component properties.</p></>}
{category==='radius'&&<div class="foundation-shapes">{Object.entries(source.tokens).filter(([key])=>key.startsWith('radius-')).map(([key])=><div style={`border-radius:var(--dmf-${key})`}><code>{key}</code></div>)}</div>}
{category==='elevation'&&<><div class="foundation-shapes">{brands.brands.qdi.spacing.slice(0,4).map((_,i)=><div class="dmf-ui" data-system="qdi" data-color-mode="light" style={`box-shadow:var(--qdi-elevation-${i+1})`}>QDI elevation {i+1}</div>)}</div><p class="docs-note">These shadows are verified QDI reference values. Shared DMF elevation uses theme shadow roles; layer order remains separate.</p></>}
{category==='motion'&&<div class="foundation-motion"><Button data-foundation-motion>Run transition</Button><div class="foundation-motion-track"><span data-foundation-motion-sample aria-hidden="true"/></div><p role="status" data-foundation-motion-status>Ready. Motion runs only when requested.</p></div>}
{category==='iconography'&&<><div class="foundation-icons">{[12,16,20,24,32].map(size=><figure><Search size={size} stroke-width={1.8} aria-hidden="true"/><figcaption>{size}px</figcaption></figure>)}</div><Button size="icon" variant="outline" aria-label="Search example" title="Search example"><Search size={20} aria-hidden="true"/></Button><p class="docs-note">The icon button is a naming specimen. It performs no search. QDI’s official icon sizes are 12, 16, 20, 26 and 30px; Lucide is the shared DMF interface library.</p></>}
{category==='accessibility'&&<><label class="foundation-label" for="foundation-readonly">Read-only value</label><input id="foundation-readonly" value="Readable and selectable" readonly/><label class="foundation-label" for="foundation-disabled">Disabled value</label><input id="foundation-disabled" value="Unavailable" disabled/><p class="docs-note">Use Tab to compare focus behavior. Read-only fields remain focusable and submitted. Disabled fields do not.</p></>}
{entries.length>0&&<div class="docs-table-scroll"><table class="docs-options"><thead><tr><th scope="col">Token</th><th scope="col">Value</th><th scope="col">Layer</th></tr></thead><tbody>{entries.map(([key,t])=><tr><th scope="row"><code>--dmf-{key}</code></th><td><code>{t.value}</code></td><td>{t.layer}</td></tr>)}</tbody></table></div>}
<p class="docs-note"><a href="/docs/foundations/">All foundations</a> · <a href="/docs/brand-mappings/">Brand mappings</a> · <a href="/docs/component-contract/">Component Contract v2</a></p>
</div>}
<script>
 document.querySelector<HTMLSelectElement>('[data-foundation-columns]')?.addEventListener('change',event=>{const select=event.currentTarget as HTMLSelectElement;document.querySelector<HTMLElement>('[data-foundation-grid]')?.style.setProperty('--foundation-columns',select.value);});
 document.querySelector<HTMLButtonElement>('[data-foundation-motion]')?.addEventListener('click',()=>{const sample=document.querySelector<HTMLElement>('[data-foundation-motion-sample]')!,status=document.querySelector<HTMLElement>('[data-foundation-motion-status]')!;sample.toggleAttribute('data-moved');status.textContent=matchMedia('(prefers-reduced-motion:reduce)').matches?'State changed. Movement is reduced by your preference.':'Transition completed to the alternate position.';});
</script>
