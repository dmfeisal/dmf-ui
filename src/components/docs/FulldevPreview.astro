---
import demoUrl from "../../assets/examples/component-demo.svg?url";
import {AspectRatio,Attachment,AttachmentAction,AttachmentActions,AttachmentContent,AttachmentDescription,AttachmentMedia,AttachmentTitle,Banner,BannerContainer,Button,ButtonGroup,ButtonGroupSeparator,Carousel,CarouselContent,CarouselItem,CarouselNext,CarouselPrevious,CodeBlock,CodeBlockActions,CodeBlockContent,CodeBlockCopyButton,CodeBlockHeader,CodeBlockTitle,Command,CommandDialog,CommandDialogTrigger,CommandEmpty,CommandGroup,CommandInput,CommandItem,CommandList,CommandShortcut,Drawer,DrawerClose,DrawerContent,DrawerDescription,DrawerFooter,DrawerHeader,DrawerTitle,DrawerTrigger,Empty,EmptyContent,EmptyDescription,EmptyHeader,EmptyMedia,EmptyTitle,Form,Header,HeaderContainer,HeaderGroup,HoverCard,HoverCardContent,HoverCardTrigger,Icon,Image,Input,Item,ItemActions,ItemContent,ItemDescription,ItemMedia,ItemTitle,Kbd,KbdGroup,Label,Logo,LogoText,Marquee,MarqueeContent,MarqueeItem,MarqueeToggle,NativeSelect,NativeSelectOptGroup,NativeSelectOption,Price,PriceUnit,PriceValue,Resizable,ResizableHandle,ResizablePanel,Section,SectionContainer,SectionDescription,SectionTitle,Spinner,ThemeToggle,Toc,TocMenu,TocMenuItem,TocMenuLink,TocTitle,Typography,TypographyA,TypographyH3,TypographyInlineCode,TypographyP,Video} from '../dmf-ui';
import {FileText,Search,BookOpen} from '@lucide/astro';
interface Props {slug:string;}
const {slug}=Astro.props;
---
{slug==='aspect-ratio'&&<div class="docs-preview-stack" data-fulldev-preview="aspect-ratio"><AspectRatio ratio={16/9} class="overflow-hidden rounded-lg border"><img src={demoUrl} alt="Three geometric panels" class="size-full object-cover" width="640" height="360"/></AspectRatio></div>}
{slug==='attachment'&&<div class="docs-preview-stack" data-fulldev-preview="attachment"><Attachment><AttachmentMedia variant="icon"><FileText size={24} aria-hidden="true"/></AttachmentMedia><AttachmentContent><AttachmentTitle>License notices</AttachmentTitle><AttachmentDescription>Local text document. No upload is running.</AttachmentDescription></AttachmentContent><AttachmentActions class="w-full justify-end"><AttachmentAction size="default" as="a" href="/dmf-ui-notices.txt" variant="outline">Read notices</AttachmentAction></AttachmentActions></Attachment></div>}
{slug==='banner'&&<div class="docs-preview-stack" data-fulldev-preview="banner"><Banner aria-label="Example announcement"><BannerContainer closeLabel="Dismiss example announcement"><p>Explore the adapted component library. <a href="/docs/introduction/">Read the introduction</a></p></BannerContainer></Banner><Button variant="outline" data-fulldev-restore-banner>Restore announcement</Button></div>}
{slug==='button-group'&&<div class="docs-preview-stack" data-fulldev-preview="button-group"><ButtonGroup aria-label="Local preview commands"><Button data-fulldev-action="First command">First</Button><ButtonGroupSeparator/><Button variant="outline" data-fulldev-action="Second command">Second</Button></ButtonGroup><p data-fulldev-feedback role="status">Choose a local command.</p></div>}
{slug==='carousel'&&<div class="docs-preview-stack" data-fulldev-preview="carousel"><Carousel aria-label="Illustrative component slides" class="mx-12"><CarouselContent>{[1,2,3].map(number=><CarouselItem><div class="rounded-lg border bg-muted p-6"><p>Example slide {number} of 3</p></div></CarouselItem>)}</CarouselContent><CarouselPrevious/><CarouselNext/></Carousel></div>}
{slug==='code-block'&&<div class="docs-preview-stack" data-fulldev-preview="code-block"><CodeBlock><CodeBlockHeader><CodeBlockTitle>Local example</CodeBlockTitle><CodeBlockActions><CodeBlockCopyButton value="const ready = true;"/></CodeBlockActions></CodeBlockHeader><CodeBlockContent code={"const ready = true;\nexport { ready };"} lineNumbers/></CodeBlock></div>}
{slug==='command'&&<div class="docs-preview-stack" data-fulldev-preview="command"><Command label="Component command list" class="rounded-lg border"><CommandInput aria-label="Search component commands" placeholder="Find a component…"/><CommandList><CommandEmpty>No matching commands.</CommandEmpty><CommandGroup heading="Components"><CommandItem href="/components/button/" value="button">Button<CommandShortcut>B</CommandShortcut></CommandItem><CommandItem href="/components/card/" value="card">Card</CommandItem><CommandItem value="unavailable" disabled>Unavailable command</CommandItem></CommandGroup></CommandList></Command><CommandDialog id="docs-fulldev-command-dialog" title="Find a guide"><CommandDialogTrigger slot="trigger" label="Open command dialog"/><Command label="Guide commands"><CommandInput aria-label="Search guide commands"/><CommandList><CommandEmpty>No matching guides.</CommandEmpty><CommandGroup heading="Guides"><CommandItem href="/docs/installation/" value="installation">Installation</CommandItem><CommandItem href="/docs/theming/" value="theming">Theming</CommandItem></CommandGroup></CommandList></Command></CommandDialog></div>}
{slug==='drawer'&&<div class="docs-preview-stack" data-fulldev-preview="drawer"><Drawer id="docs-fulldev-drawer"><DrawerTrigger>Open drawer</DrawerTrigger><DrawerContent showSwipeHandle><DrawerHeader><DrawerTitle>Local drawer preview</DrawerTitle><DrawerDescription>Use the close control or Escape. Nothing is saved.</DrawerDescription></DrawerHeader><div class="px-4"><Label for="docs-fulldev-drawer-value">Draft label</Label><Input id="docs-fulldev-drawer-value" value="Local draft"/></div><DrawerFooter><DrawerClose>Close drawer</DrawerClose></DrawerFooter></DrawerContent></Drawer></div>}
{slug==='empty'&&<div class="docs-preview-stack" data-fulldev-preview="empty"><Empty><EmptyHeader><EmptyMedia variant="icon"><Search size={24} aria-hidden="true"/></EmptyMedia><EmptyTitle>No saved examples</EmptyTitle><EmptyDescription>Browse the library for a starting point.</EmptyDescription></EmptyHeader><EmptyContent><Button as="a" href="/components/">Browse components</Button></EmptyContent></Empty></div>}
{slug==='form'&&<div class="docs-preview-stack" data-fulldev-preview="form"><Form data-fulldev-form><Label for="docs-fulldev-form-name">Preview name</Label><Input id="docs-fulldev-form-name" name="name" value="Local draft" required/><div class="docs-preview-row"><Button type="submit" disabled data-fulldev-submit>Inspect values</Button><Button type="reset" variant="outline">Reset</Button></div><p data-fulldev-form-status role="status">Nothing is submitted to a server.</p></Form></div>}
{slug==='header'&&<div class="docs-preview-stack" data-fulldev-preview="header"><Header class="rounded-lg border"><HeaderContainer class="flex-wrap"><HeaderGroup><strong>DMF UI</strong></HeaderGroup><HeaderGroup><nav aria-label="Example header navigation" class="docs-preview-row"><a href="/components/">Components</a><a href="/docs/">Docs</a></nav></HeaderGroup></HeaderContainer></Header></div>}
{slug==='hover-card'&&<div class="docs-preview-stack" data-fulldev-preview="hover-card"><HoverCard delay={100} closeDelay={100}><HoverCardTrigger href="/docs/introduction/">About DMF UI</HoverCardTrigger><HoverCardContent><p>Experimental, source-owned Astro components.</p><a href="/docs/introduction/">Read the introduction</a></HoverCardContent></HoverCard></div>}
{slug==='icon'&&<div class="docs-preview-stack" data-fulldev-preview="icon"><div class="docs-preview-row"><Icon name="search" width={24} height={24} aria-hidden="true"/><span>Decorative search icon</span><a href="https://github.com/dmfeisal/dmf-ui" aria-label="DMF UI GitHub repository"><Icon name="simple:github" width={24} height={24} aria-hidden="true"/></a></div></div>}
{slug==='image'&&<div class="docs-preview-stack" data-fulldev-preview="image"><Image src={demoUrl} alt="Three geometric panels" width={640} height={360} inferSize={false} class="rounded-lg border"/></div>}
{slug==='item'&&<div class="docs-preview-stack" data-fulldev-preview="item"><Item variant="outline"><ItemMedia variant="icon"><BookOpen size={24} aria-hidden="true"/></ItemMedia><ItemContent><ItemTitle>Installation guide</ItemTitle><ItemDescription>Prepare a pinned local consumer.</ItemDescription></ItemContent><ItemActions><Button as="a" href="/docs/installation/" variant="outline">Read guide</Button></ItemActions></Item></div>}
{slug==='kbd'&&<div class="docs-preview-stack" data-fulldev-preview="kbd"><p>Open search with <KbdGroup><Kbd>Ctrl</Kbd><span>+</span><Kbd>K</Kbd></KbdGroup>. These labels do not register a shortcut.</p></div>}
{slug==='layout'&&<div class="docs-preview-stack" data-fulldev-preview="layout"><p>Layout renders a complete document, so its preview has a separate page.</p><a href="/examples/layout/">Open the standalone layout example</a></div>}
{slug==='logo'&&<div class="docs-preview-stack" data-fulldev-preview="logo"><Logo href="/" aria-label="DMF UI home"><LogoText>DMF UI</LogoText></Logo></div>}
{slug==='marquee'&&<div class="docs-preview-stack" data-fulldev-preview="marquee"><Marquee><MarqueeContent>{["Astro","Tokens","Components","Documentation","Presets"].map(label=><MarqueeItem class="basis-1/2"><div class="rounded-lg border bg-muted p-4">{label}</div></MarqueeItem>)}</MarqueeContent><MarqueeToggle playLabel="Resume example marquee" pauseLabel="Pause example marquee" class="mt-4">Toggle motion</MarqueeToggle></Marquee></div>}
{slug==='native-select'&&<div class="docs-preview-stack" data-fulldev-preview="native-select"><Form data-fulldev-form><Label for="docs-fulldev-native-select">Example category</Label><NativeSelect id="docs-fulldev-native-select" name="category" multiple={false}><NativeSelectOptGroup label="Components"><NativeSelectOption value="content">Content</NativeSelectOption><NativeSelectOption value="forms">Forms</NativeSelectOption><NativeSelectOption value="unavailable" disabled>Unavailable</NativeSelectOption></NativeSelectOptGroup></NativeSelect><div class="docs-preview-row"><Button type="submit" disabled data-fulldev-submit>Inspect selection</Button><Button type="reset" variant="outline">Reset</Button></div><p data-fulldev-form-status role="status">Nothing is submitted to a server.</p></Form></div>}
{slug==='price'&&<div class="docs-preview-stack" data-fulldev-preview="price"><Price><PriceValue price={120000} compareAt={150000} currency="IDR" locale="id-ID"/><PriceUnit>/ example item</PriceUnit></Price><p class="docs-note">Illustrative values only; no checkout or live pricing.</p></div>}
{slug==='resizable'&&<div class="docs-preview-stack" data-fulldev-preview="resizable"><Resizable class="min-h-48 rounded-lg border" keyboardResizeBy={10}><ResizablePanel defaultSize={50} minSize={20}><div class="p-4">First panel</div></ResizablePanel><ResizableHandle aria-label="Resize example panels" withHandle/><ResizablePanel defaultSize={50} minSize={20}><div class="p-4">Second panel</div></ResizablePanel></Resizable></div>}
{slug==='section'&&<div class="docs-preview-stack" data-fulldev-preview="section"><Section aria-labelledby="docs-fulldev-section-title" class="rounded-lg border"><SectionContainer class="py-6"><SectionTitle id="docs-fulldev-section-title" as="h3">A focused section</SectionTitle><SectionDescription>Use a heading level that fits the host document.</SectionDescription></SectionContainer></Section></div>}
{slug==='spinner'&&<div class="docs-preview-stack" data-fulldev-preview="spinner"><div class="docs-preview-row"><Spinner aria-label="Illustrative loading indicator"/><p>Illustrative pending state. No request is running.</p></div></div>}
{slug==='theme-toggle'&&<div class="docs-preview-stack" data-fulldev-preview="theme-toggle"><ThemeToggle/><p>The button changes this documentation theme and stays synchronized with the header.</p></div>}
{slug==='toc'&&<div class="docs-preview-stack" data-fulldev-preview="toc"><Toc aria-label="Example page sections"><TocTitle>On this page</TocTitle><TocMenu><TocMenuItem><TocMenuLink href="#usage">Usage</TocMenuLink></TocMenuItem><TocMenuItem><TocMenuLink href="#options">Core options</TocMenuLink></TocMenuItem><TocMenuItem><TocMenuLink href="#behavior">Behavior</TocMenuLink></TocMenuItem></TocMenu></Toc></div>}
{slug==='typography'&&<div class="docs-preview-stack" data-fulldev-preview="typography"><Typography><TypographyH3>Readable source-owned content</TypographyH3><TypographyP>Compose text with <TypographyInlineCode>semantic tokens</TypographyInlineCode> and <TypographyA href="/docs/theming/">theming guidance</TypographyA>.</TypographyP></Typography></div>}
{slug==='video'&&<div class="docs-preview-stack" data-fulldev-preview="video"><p>Loading this optional preview contacts YouTube. Nothing loads until you choose it.</p><Button data-fulldev-load-video>Load video preview</Button><div data-fulldev-video-host></div><template data-fulldev-video-template><Video src="https://www.youtube.com/watch?v=aqz-KE-bpKQ" title="Big Buck Bunny video preview" loading="lazy"/></template></div>}
<script>
 const owners=new Map<HTMLElement,AbortController>();
 function initialize(){for(const root of document.querySelectorAll<HTMLElement>('[data-fulldev-preview]')){
  if(owners.has(root))continue;const abort=new AbortController();owners.set(root,abort);const signal=abort.signal;
  root.addEventListener('click',event=>{const target=event.target instanceof Element?event.target.closest<HTMLElement>('[data-fulldev-action],[data-fulldev-restore-banner],[data-fulldev-load-video]'):null;if(!target)return;const feedback=root.querySelector<HTMLElement>('[data-fulldev-feedback]');if(target.dataset.fulldevAction&&feedback)feedback.textContent=`${target.dataset.fulldevAction} selected locally.`;if(target.hasAttribute('data-fulldev-restore-banner'))root.querySelector<HTMLElement>('[data-slot=banner]')?.removeAttribute('hidden');if(target.hasAttribute('data-fulldev-load-video')){const host=root.querySelector('[data-fulldev-video-host]')!;const template=root.querySelector<HTMLTemplateElement>('[data-fulldev-video-template]')!;host.replaceChildren(template.content.cloneNode(true));target.setAttribute('disabled','');}},{signal});
  for(const form of root.querySelectorAll<HTMLFormElement>('[data-fulldev-form]')){const status=form.querySelector<HTMLElement>('[data-fulldev-form-status]')!;form.addEventListener('submit',event=>{event.preventDefault();status.textContent=[...new FormData(form)].map(([key,value])=>`${key}: ${value}`).join('; ')+'. Nothing was saved or sent.';},{signal});form.addEventListener('reset',()=>{status.textContent='Form reset to its initial values.';},{signal});form.querySelector('[data-fulldev-submit]')?.removeAttribute('disabled');}
 }}
 initialize();document.addEventListener('astro:page-load',initialize);document.addEventListener('astro:before-swap',()=>{for(const abort of owners.values())abort.abort();owners.clear();});
</script>
