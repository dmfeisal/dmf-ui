---
import {Collapsible} from '../dmf-ui/collapsible';
import {Toggle} from '../dmf-ui/toggle';
import {ToggleGroup} from '../dmf-ui/toggle-group';
import {Combobox} from '../dmf-ui/combobox';
import {Button} from '../dmf-ui/button';
import {Info,Bold,Italic,Underline,TextAlignStart,TextAlignCenter,TextAlignEnd,MousePointer2,RectangleHorizontal,SlidersHorizontal} from '@lucide/astro';
interface Props {slug:string;}
const {slug}=Astro.props;
const presentations=['label','icon-label','icon'] as const;
const options=[{value:'button',label:'Button',icon:MousePointer2},{value:'card',label:'Card',icon:RectangleHorizontal},{value:'slider',label:'Slider',icon:SlidersHorizontal},{value:'native',label:'Native adapter (unavailable)',disabled:true}];
---
{slug==='collapsible'&&<div class="docs-preview-stack">{presentations.map(presentation=><div data-example-presentation={presentation}><p>{presentation==='label'?'Label only':presentation==='icon-label'?'Icon + label':'Icon only'}</p><Collapsible label="Implementation notes" icon={Info} presentation={presentation} defaultOpen={presentation==='icon-label'}><p>Content stays in the document. Each disclosure opens independently.</p><a href="/docs/accessibility/">Read accessibility guidance</a></Collapsible></div>)}</div>}
{slug==='toggle'&&<div class="docs-preview-stack">{presentations.map(presentation=><div data-toggle-demo data-example-presentation={presentation}><p>{presentation==='label'?'Label only':presentation==='icon-label'?'Icon + label':'Icon only'}</p><Toggle label="Bold" icon={Bold} presentation={presentation} variant="outline"/><p data-toggle-sample>Try formatting this local sample.</p><p data-toggle-status role="status">Bold is off.</p></div>)}<Toggle label="Unavailable command" disabled/></div>}
{slug==='toggle-group'&&<div class="docs-preview-stack">{presentations.map(presentation=><div data-toggle-demo data-example-presentation={presentation}><p>{presentation==='label'?'Label only':presentation==='icon-label'?'Icon + label':'Icon only'}</p><ToggleGroup label={`${presentation} formatting`} type="multiple" presentation={presentation} items={[{value:'bold',label:'Bold',icon:Bold},{value:'italic',label:'Italic',icon:Italic},{value:'underline',label:'Underline',icon:Underline,disabled:true}]}/><p data-toggle-sample>Formatting applies only to this sample.</p><p data-toggle-status role="status">No formatting selected.</p></div>)}<div data-toggle-demo><p>Single selection</p><ToggleGroup label="Sample alignment" type="single" defaultValue={['start']} items={[{value:'start',label:'Align start',icon:TextAlignStart},{value:'center',label:'Align center',icon:TextAlignCenter},{value:'end',label:'Align end',icon:TextAlignEnd}]} presentation="icon-label"/><p data-toggle-sample>Align this sample.</p><p data-toggle-status role="status">Start alignment selected.</p></div></div>}
{slug==='combobox'&&<form data-combobox-demo class="docs-preview-stack"><p>Search local options, then choose with Enter or a pointer. Nothing is saved or sent.</p><Combobox id="docs-combobox-component" label="Component" name="component" items={options} required/><Combobox id="docs-combobox-reference" label="Optional reference" name="reference" defaultValue="card" items={options}/><Combobox id="docs-combobox-disabled" label="Unavailable selection" name="unavailable" disabled defaultValue="button" items={options}/><div class="docs-preview-row"><Button type="submit">Inspect selection</Button><Button type="reset" variant="outline">Reset selections</Button></div><p role="status" data-combobox-demo-status>No selections inspected.</p></form>}
<script>
 const owners=new Map<HTMLElement,AbortController>();
 function initialize(){for(const root of document.querySelectorAll<HTMLElement>('[data-toggle-demo], [data-combobox-demo]')){
  if(owners.has(root))continue;const abort=new AbortController();owners.set(root,abort);const signal=abort.signal;
  const update=()=>{const sample=root.querySelector<HTMLElement>('[data-toggle-sample]')!;const status=root.querySelector<HTMLElement>('[data-toggle-status]')!;const pressed=[...root.querySelectorAll<HTMLButtonElement>('[data-dmf-toggle][aria-pressed=true]')];const values=pressed.map(button=>button.dataset.value);sample.style.fontWeight=values.includes('bold')||(!root.querySelector('[data-slot=toggle-group]')&&pressed.length)?'700':'';sample.style.fontStyle=values.includes('italic')?'italic':'';sample.style.textDecoration=values.includes('underline')?'underline':'';sample.style.textAlign=values.find(value=>['start','center','end'].includes(value??''))??'';status.textContent=pressed.length?`Selected: ${pressed.map(button=>button.textContent?.trim()).join(', ')}.`:'No formatting selected.';};
  root.addEventListener('toggle:change',update,{signal});
  if(root instanceof HTMLFormElement){const status=root.querySelector<HTMLElement>('[data-combobox-demo-status]')!;root.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(root);status.textContent=`Component: ${data.get('component')}; reference: ${data.get('reference')||'none'}. Nothing was saved or sent.`;},{signal});root.addEventListener('reset',()=>{status.textContent='Selections reset to their initial values.';},{signal});}
 }}
 initialize();document.addEventListener('astro:page-load',initialize);document.addEventListener('astro:before-swap',()=>{for(const abort of owners.values())abort.abort();owners.clear();});
</script>
