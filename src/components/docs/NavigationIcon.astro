---
import {FolderOpen,Hash,Table2,List,SlidersHorizontal as RangeIcon,LoaderCircle,Inbox,Gauge,RectangleEllipsis,House,Blocks,BookOpen,Palette,MousePointer2,TextCursorInput,SquareCheck,ToggleLeft,PanelTop,MessageSquare,ChevronDown,ListFilter,SlidersHorizontal,Minus,TextAlignStart,RectangleHorizontal,Tag,TriangleAlert,Info,Layers,Code,Download,Paintbrush,ShieldCheck,FileText,Copyright,Shapes} from '@lucide/astro';
interface Props {name:string;size?:number;}
const {name,size=16}=Astro.props;
const icons:Record<string,typeof House>={'aspect-ratio':RectangleHorizontal,attachment:FileText,banner:TriangleAlert,'button-group':PanelTop,carousel:ChevronDown,'code-block':Code,command:ListFilter,drawer:PanelTop,empty:MessageSquare,form:FileText,header:PanelTop,'hover-card':MessageSquare,icon:Shapes,image:RectangleHorizontal,item:List,kbd:TextCursorInput,layout:PanelTop,logo:House,marquee:TextAlignStart,'native-select':ChevronDown,price:Tag,resizable:SlidersHorizontal,section:Blocks,spinner:LoaderCircle,'theme-toggle':ToggleLeft,toc:List,typography:TextAlignStart,video:RectangleHorizontal,'fulldev-adoption':Download,sheet:PanelTop,'alert-dialog':TriangleAlert,'input-group':TextCursorInput,'number-field':Hash,'file-input':FolderOpen,collapsible:ChevronDown,toggle:ToggleLeft,'toggle-group':SlidersHorizontal,combobox:ListFilter,table:Table2,'description-list':List,slider:RangeIcon,skeleton:RectangleEllipsis,'empty-state':Inbox,progress:Gauge,'loading-button':LoaderCircle,breadcrumb:ChevronDown,pagination:PanelTop,'navigation-menu':ListFilter,avatar:House,rating:Shapes,chip:Tag,'tag-list':Tag,'project-action-bar':PanelTop,'section-navigation':ListFilter,'archive-index':ListFilter,sidebar:PanelTop,'responsive-navigation':ListFilter,home:House,components:Blocks,docs:BookOpen,create:Palette,button:MousePointer2,input:TextCursorInput,textarea:TextAlignStart,checkbox:SquareCheck,switch:ToggleLeft,'radio-group':ListFilter,select:SlidersHorizontal,dialog:PanelTop,popover:MessageSquare,tooltip:Info,accordion:Layers,'dropdown-menu':ChevronDown,tabs:PanelTop,separator:Minus,label:Tag,field:RectangleHorizontal,text:TextAlignStart,card:RectangleHorizontal,badge:Tag,alert:TriangleAlert,toast:MessageSquare,introduction:BookOpen,installation:Download,theming:Paintbrush,presets:Palette,accessibility:ShieldCheck,credits:Copyright,contracts:FileText,icons:Shapes};
const Icon=icons[name]??Code;
---
<Icon size={size} stroke-width={1.8} aria-hidden="true" class="docs-nav-icon"/>
