---
import {House,Blocks,BookOpen,Palette,MousePointer2,TextCursorInput,SquareCheck,ToggleLeft,PanelTop,MessageSquare,ChevronDown,ListFilter,SlidersHorizontal,Minus,TextAlignStart,RectangleHorizontal,Tag,TriangleAlert,Info,Layers,Code,Download,Paintbrush,ShieldCheck,FileText,Copyright,Shapes} from '@lucide/astro';
interface Props {name:string;size?:number;}
const {name,size=16}=Astro.props;
const icons:Record<string,typeof House>={home:House,components:Blocks,docs:BookOpen,create:Palette,button:MousePointer2,input:TextCursorInput,textarea:TextAlignStart,checkbox:SquareCheck,switch:ToggleLeft,'radio-group':ListFilter,select:SlidersHorizontal,dialog:PanelTop,popover:MessageSquare,tooltip:Info,accordion:Layers,'dropdown-menu':ChevronDown,tabs:PanelTop,separator:Minus,label:Tag,field:RectangleHorizontal,text:TextAlignStart,card:RectangleHorizontal,badge:Tag,alert:TriangleAlert,toast:MessageSquare,introduction:BookOpen,installation:Download,theming:Paintbrush,presets:Palette,accessibility:ShieldCheck,credits:Copyright,contracts:FileText,icons:Shapes};
const Icon=icons[name]??Code;
---
<Icon size={size} stroke-width={1.8} aria-hidden="true" class="docs-nav-icon"/>
