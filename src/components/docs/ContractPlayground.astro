---
import {Button} from '../dmf-ui/button';
import {Input} from '../dmf-ui/input';
import {CodeSnippet} from '../dmf-ui/code-block';
import {Search} from '@lucide/astro';
interface Props {slug:string;}
const {slug}=Astro.props;
---
{slug==='button'&&<section class="docs-section" aria-labelledby="button-contract-title" data-button-contract>
<h2 id="button-contract-title">Configure Button</h2><p class="docs-note">These controls use the actual Button variant and size functions. Icons are authored content. Loading belongs to <a href="/components/loading-button/">Loading Button</a>.</p>
<form class="contract-controls" aria-label="Button properties" hidden><label>Variant<select name="variant"><option>default</option><option>secondary</option><option>outline</option><option>ghost</option><option>destructive</option><option>link</option></select></label><label>Size<select name="size"><option>default</option><option>md</option><option>xs</option><option>sm</option><option>lg</option></select></label><label>Content<select name="icons"><option value="label">Label only</option><option value="leading">Leading icon + label</option><option value="trailing">Label + trailing icon</option><option value="both">Both icons + label</option><option value="icon">Icon only</option></select></label><label>Width<select name="width"><option value="hug">Natural</option><option value="fill">Full width</option></select></label><label><input name="disabled" type="checkbox"/>Disabled</label><button type="reset">Reset properties</button></form>
<div class="contract-example"><Button data-contract-button><span data-contract-leading hidden><Search aria-hidden="true"/></span><span data-contract-label>Search example</span><span data-contract-trailing hidden><Search aria-hidden="true"/></span></Button><p role="status" data-contract-action-status>Local action. Nothing is submitted or saved.</p></div><CodeSnippet id="contract-button-code" code={'<Button variant="default" size="default">Search example</Button>'} title="Configured Button" label="Configured Button code"/>
</section>}
{slug==='input'&&<section class="docs-section" aria-labelledby="input-contract-title" data-input-contract>
<h2 id="input-contract-title">Configure Input</h2><p class="docs-note">Native properties control behavior. Required validation runs when submitted; error text stays next to the field.</p><form class="contract-controls" aria-label="Input properties" hidden><label><input type="checkbox" name="disabled"/>Disabled</label><label><input type="checkbox" name="readonly"/>Read-only</label><label><input type="checkbox" name="required"/>Required</label><button type="reset">Reset properties</button></form>
<form data-contract-input-form><label class="foundation-label" for="contract-input">Project name</label><Input id="contract-input" name="project" aria-describedby="contract-input-help contract-input-error"/><p id="contract-input-help">A native text value. This example does not save it.</p><p id="contract-input-error" aria-live="polite"/><Button type="submit" disabled>Validate example</Button><Button type="reset" variant="outline">Reset value</Button><p role="status" data-contract-input-status/></form>
</section>}
<script>
 import {buttonVariants,type ButtonVariantProps} from '../dmf-ui/button/button-variants';
 const owners=new Map<HTMLElement,AbortController>();
 function initializeButton(){for(const host of document.querySelectorAll<HTMLElement>('[data-button-contract]')){
  if(owners.has(host))continue;
  const abort=new AbortController(),signal=abort.signal;owners.set(host,abort);
  const form=host.querySelector<HTMLFormElement>('form')!,button=host.querySelector<HTMLButtonElement>('[data-contract-button]')!,code=host.querySelector<HTMLElement>('#contract-button-code code')!,copy=host.querySelector<HTMLButtonElement>('[data-copy-target="contract-button-code"]')!,status=host.querySelector<HTMLElement>('[data-contract-action-status]')!;
  code.dataset.contractButtonCode='';form.hidden=false;
  const update=()=>{
   const data=new FormData(form),variant=String(data.get('variant')) as NonNullable<ButtonVariantProps['variant']>,content=String(data.get('icons')),chosen=String(data.get('size'));
   const icons:Record<string,NonNullable<ButtonVariantProps['size']>>={default:'icon',md:'icon',xs:'icon-xs',sm:'icon-sm',lg:'icon-lg'};
   const size=(content==='icon'?icons[chosen]:chosen) as NonNullable<ButtonVariantProps['size']>,fill=data.get('width')==='fill';
   button.className=buttonVariants({variant,size})+(fill?' w-full':'');button.dataset.variant=variant;button.dataset.size=size;button.disabled=data.has('disabled');
   button.querySelector<HTMLElement>('[data-contract-label]')!.hidden=content==='icon';
   button.querySelector('[data-contract-leading]')!.toggleAttribute('hidden',!['leading','both','icon'].includes(content));button.querySelector('[data-contract-trailing]')!.toggleAttribute('hidden',!['trailing','both'].includes(content));
   if(content==='icon')button.setAttribute('aria-label','Search example');else button.removeAttribute('aria-label');
   const source=`<Button variant="${variant}" size="${size}"${fill?' class="w-full"':''}${button.disabled?' disabled':''}${content==='icon'?' aria-label="Search example"':''}>${content==='icon'?'<Search aria-hidden="true" />':content==='label'?'Search example':content==='leading'?'<Search aria-hidden="true" /> Search example':content==='trailing'?'Search example <Search aria-hidden="true" />':'<Search aria-hidden="true" /> Search example <Search aria-hidden="true" />'}</Button>`;
   code.textContent=source;copy.dataset.copyValue=source;status.textContent='Local action. Nothing is submitted or saved.';
  };
  form.addEventListener('change',update,{signal});form.addEventListener('submit',event=>event.preventDefault(),{signal});form.addEventListener('reset',()=>requestAnimationFrame(()=>{if(!signal.aborted)update();}),{signal});
  button.addEventListener('click',()=>{status.textContent='Example activated. Nothing was submitted or saved.';},{signal});
 }}
 initializeButton();document.addEventListener('astro:page-load',initializeButton);document.addEventListener('astro:before-swap',()=>{for(const abort of owners.values())abort.abort();owners.clear();});
 const inputHost=document.querySelector<HTMLElement>('[data-input-contract]');
 if(inputHost){const properties=inputHost.querySelector<HTMLFormElement>('.contract-controls')!,form=inputHost.querySelector<HTMLFormElement>('[data-contract-input-form]')!,input=form.querySelector<HTMLInputElement>('input')!,error=form.querySelector<HTMLElement>('#contract-input-error')!,status=form.querySelector<HTMLElement>('[data-contract-input-status]')!;properties.hidden=false;form.noValidate=true;form.querySelector<HTMLButtonElement>('button[type=submit]')!.disabled=false;const clear=()=>{input.removeAttribute('aria-invalid');error.textContent='';status.textContent='';};const update=()=>{const data=new FormData(properties);input.disabled=data.has('disabled');input.readOnly=data.has('readonly');input.required=data.has('required');clear();};properties.addEventListener('change',update);properties.addEventListener('reset',()=>requestAnimationFrame(update));form.addEventListener('submit',event=>{event.preventDefault();clear();if(!input.checkValidity()){input.setAttribute('aria-invalid','true');error.textContent=input.validationMessage;input.focus();}else status.textContent=input.disabled?'Disabled field omitted from form values.':'Native validation passed. Nothing was saved.';});form.addEventListener('reset',clear);input.addEventListener('input',clear);}
</script>
