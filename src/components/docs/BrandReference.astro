---
import brands from '../../../contracts/brands.json';
const palettes=[{name:'HUI',values:Object.entries(brands.brands.hui.palette).map(([name,value])=>({name,value}))},{name:'QDI UI',values:Object.entries(brands.brands.qdi.palette).flatMap(([family,values])=>values.map((value,i)=>({name:`${family} · source position ${i+1}`,value})))}];
---
<section class="docs-section" aria-labelledby="brand-reference-title"><h2 id="brand-reference-title">Verified palette reference</h2><p class="docs-note">Swatches retain the source values. Semantic pairings are separate application choices. Copy controls appear when scripting is available.</p>{palettes.map(palette=><section class="docs-section" aria-label={`${palette.name} palette`}><h3>{palette.name}</h3><ul class="brand-swatches">{palette.values.map(({name,value})=><li><span class="brand-swatch" style={`background:${value}`} aria-hidden="true"/><strong>{name}</strong><code tabindex="-1">{value}</code><button type="button" data-brand-copy={value} aria-label={`Copy value ${name} ${value}`} hidden>Copy value</button></li>)}</ul></section>)}<p role="status" data-brand-copy-status/></section>
<script>
 for(const button of document.querySelectorAll<HTMLButtonElement>('[data-brand-copy]')){button.hidden=false;button.addEventListener('click',async()=>{const status=document.querySelector<HTMLElement>('[data-brand-copy-status]')!;try{await navigator.clipboard.writeText(button.dataset.brandCopy!);status.textContent=`Copied ${button.dataset.brandCopy}.`;}catch{const code=button.parentElement!.querySelector('code')!;const selection=getSelection(),range=document.createRange();range.selectNodeContents(code);selection?.removeAllRanges();selection?.addRange(range);code.focus();status.textContent='Copy unavailable. The value is selected for manual copying.';}});}
</script>
