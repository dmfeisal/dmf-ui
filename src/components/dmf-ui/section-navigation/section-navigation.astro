---
import type {HTMLAttributes} from 'astro/types';
import Link from '../navigation-link.astro';
import type {NavigationIcon,Presentation} from '../navigation-types';
import {cn} from '../utils';
interface Props extends HTMLAttributes<'nav'> {items:{id:string;label:string;icon?:NavigationIcon}[];label?:string;currentId?:string;presentation?:Presentation;}
const {items,label='Page sections',currentId,presentation='label',class:className,...props}=Astro.props;
if(new Set(items.map(item=>item.id)).size!==items.length||items.some(item=>!item.id))throw new Error('SectionNavigation requires non-empty unique section IDs.');
---
<nav data-slot="section-navigation" data-dmf-section-nav data-presentation={presentation} aria-label={label} class={cn('dmf-section-navigation',className)} {...props}><ol>{items.map((item,index)=><li><Link item={{label:item.label,href:`#${encodeURIComponent(item.id)}`,icon:item.icon,current:currentId===item.id}} presentation={presentation} currentType="location"/>{presentation==='label'&&<span class="dmf-section-index" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>}</li>)}</ol></nav>
<script>
 const owners=new Map<HTMLElement,{abort:AbortController;dispose:()=>void}>();
 function initialize(){for(const root of document.querySelectorAll<HTMLElement>('[data-dmf-section-nav]')){
  if(owners.has(root))continue;
  const links=[...root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
  const targets=links.map(link=>document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((element):element is HTMLElement=>!!element);
  const setCurrent=(id:string)=>{for(const link of links){if(decodeURIComponent(link.hash.slice(1))===id)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}};
  const hashId=()=>{try{return decodeURIComponent(location.hash.slice(1));}catch{return '';}};
  const syncHash=()=>{const id=hashId();if(targets.some(target=>target.id===id))setCurrent(id);};
  const update=()=>{
   const height=window.innerHeight,line=height*.25;
   const visible=targets.map(target=>({id:target.id,rect:target.getBoundingClientRect()})).filter(item=>item.rect.height>0&&item.rect.bottom>0&&item.rect.top<height).sort((a,b)=>a.rect.top-b.rect.top);
   const hash=visible.find(item=>item.id===hashId()&&item.rect.top>=0&&item.rect.top<height*.6);
   const current=hash??visible.find(item=>item.rect.top<=line&&item.rect.bottom>line)??visible.find(item=>item.rect.top>line)??visible.at(-1);
   if(current)setCurrent(current.id);
  };
  let observer:IntersectionObserver|undefined,frame=0;
  const observe=()=>{observer?.disconnect();const height=window.innerHeight;observer=new IntersectionObserver(update,{rootMargin:`-${Math.floor(height*.25)}px 0px -${Math.floor(height*.74)}px 0px`});for(const target of targets)observer.observe(target);};
  const abort=new AbortController();window.addEventListener('hashchange',syncHash,{signal:abort.signal});window.addEventListener('resize',()=>{if(frame)return;frame=requestAnimationFrame(()=>{frame=0;observe();});},{signal:abort.signal,passive:true});
  owners.set(root,{abort,dispose:()=>{observer?.disconnect();cancelAnimationFrame(frame);}});observe();syncHash();
 }}
 initialize();document.addEventListener('astro:page-load',initialize);document.addEventListener('astro:before-swap',()=>{for(const {abort,dispose} of owners.values()){abort.abort();dispose();}owners.clear();});
</script>
