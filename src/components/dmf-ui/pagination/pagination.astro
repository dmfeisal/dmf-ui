---
import type {HTMLAttributes} from 'astro/types';
import {ChevronLeft,ChevronRight,Ellipsis} from '@lucide/astro';
import {cn} from '../utils';
interface Props extends HTMLAttributes<'nav'> {page:number;totalPages:number;pageHref:(page:number)=>string;label?:string;}
const {page,totalPages,pageHref,label='Pagination',class:className,...props}=Astro.props;
if(!Number.isSafeInteger(totalPages)||totalPages<1||!Number.isSafeInteger(page)||page<1||page>totalPages)throw new Error('Pagination requires integer page and totalPages, with 1 <= page <= totalPages.');
const visible=[...new Set([1,totalPages,...Array.from({length:5},(_,i)=>page+i-2).filter(n=>n>0&&n<=totalPages)])].sort((a,b)=>a-b);
---
<nav data-slot="pagination" aria-label={label} class={cn('dmf-pagination',className)} {...props}><ul><li>{page>1?<a href={pageHref(page-1)} rel="prev"><ChevronLeft size={16} aria-hidden="true"/><span>Previous</span></a>:<span aria-disabled="true"><ChevronLeft size={16} aria-hidden="true"/><span>Previous</span></span>}</li>{visible.map((number,index)=><>{index>0&&number-visible[index-1]>1&&<li class="dmf-pagination-gap"><Ellipsis size={18} aria-hidden="true"/><span class="dmf-navigation-sr">More pages</span></li>}<li><a href={pageHref(number)} aria-label={`Page ${number}`} aria-current={number===page?'page':undefined}>{number}</a></li></>)}<li>{page<totalPages?<a href={pageHref(page+1)} rel="next"><span>Next</span><ChevronRight size={16} aria-hidden="true"/></a>:<span aria-disabled="true"><span>Next</span><ChevronRight size={16} aria-hidden="true"/></span>}</li></ul></nav>
