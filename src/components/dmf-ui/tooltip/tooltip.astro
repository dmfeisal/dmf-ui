---
import type { HTMLAttributes } from "astro/types"
import type { TooltipAlign, TooltipSide } from "@data-slot/tooltip"

import { cn } from "../utils"

type Props = HTMLAttributes<"div"> & {
  mountStrategy?: "lazy" | "eager"
  delay?: number
  skipDelayDuration?: number
  side?: TooltipSide
  align?: TooltipAlign
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  portal?: boolean
}

const {
  mountStrategy,
  class: className,
  delay = 300,
  skipDelayDuration = 300,
  side = "top",
  align = "center",
  sideOffset = 4,
  alignOffset = 0,
  avoidCollisions = true,
  collisionPadding = 8,
  portal = true,
  ...props
} = Astro.props
---

<div
  data-slot="tooltip"
  data-dmf-tooltip
  data-mount-strategy={mountStrategy}
  data-delay={delay}
  data-skip-delay-duration={skipDelayDuration}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  data-portal={portal}
  class={cn(className)}
  {...props}
>
  <slot />
</div>

<script>
  import { createTooltip, type TooltipController } from '@data-slot/tooltip';
  import { prepareOverlayScope } from '../overlay-scope';
  const bindings = new Map<HTMLElement, {controller: TooltipController; cleanup: () => void}>();
  function initialize() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-dmf-tooltip]')) {
      if (bindings.has(root)) continue;
      const scope = prepareOverlayScope(root, 'tooltip');
      const controller = createTooltip(root, {onOpenChange: scope.sync});
      bindings.set(root, {controller, cleanup: scope.cleanup});
      root.dataset.dmfTooltipReady = 'true';
    }
  }
  initialize(); document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => {
    for (const [root, binding] of bindings) { binding.controller.destroy(); binding.cleanup(); delete root.dataset.dmfTooltipReady; }
    bindings.clear();
  });
</script>
