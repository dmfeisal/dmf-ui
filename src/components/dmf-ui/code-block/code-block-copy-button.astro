---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"
import CopyIcon from "@lucide/astro/icons/copy"

import { cn } from "../utils"
import { Button, type ButtonVariantProps } from "../button"

type Props = Omit<HTMLAttributes<"button">, "value" | "type"> &
  ButtonVariantProps & {
    targetId?: string
    statusId?: string
    value: string
    copyLabel?: string
    copiedLabel?: string
    errorLabel?: string
  }

const {
  class: className,
  value,
  targetId,
  statusId,
  variant = "ghost",
  size = "icon-xs",
  copyLabel = "Copy",
  copiedLabel = "Copied",
  errorLabel = "Could not copy",
  ...props
} = Astro.props
---

<Button
  data-slot="code-block-copy-button"
  hidden
  data-code-copy
  data-copy-target={targetId}
  data-copy-value={value}
  data-copy-label={copyLabel}
  data-copied-label={copiedLabel}
  data-error-label={errorLabel}
  title={copyLabel}
  aria-label={copyLabel}
  variant={variant}
  size={size}
  class={cn("group/code-copy", className)}
  {...props}
>
  <CopyIcon aria-hidden="true" class="group-data-copied/code-copy:hidden" />
  <CheckIcon
    aria-hidden="true"
    class="hidden group-data-copied/code-copy:block"
  />
</Button>
<span id={statusId} role="status" data-copy-status aria-live="polite" class="sr-only"></span>

<script>
  function initialize(){for(const button of document.querySelectorAll<HTMLButtonElement>('[data-code-copy]'))button.hidden=false;}
  initialize();document.addEventListener('astro:page-load',initialize);
  const requests=new WeakMap<HTMLButtonElement,number>();
  const timers = new Map<HTMLButtonElement, ReturnType<typeof setTimeout>>()
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest<HTMLButtonElement>(
      "[data-slot=code-block-copy-button]"
    )
    if (!button || button.disabled || event.defaultPrevented) return
    const request=(requests.get(button)??0)+1;requests.set(button,request);
    const status = button.nextElementSibling
    try {
      await navigator.clipboard.writeText(button.dataset.copyValue ?? "")
      if (!button.isConnected||requests.get(button)!==request) return
      clearTimeout(timers.get(button))
      button.dataset.copied = ""
      button.setAttribute("aria-label", button.dataset.copyLabel ?? "Copy")
      if (status) status.textContent = button.dataset.copiedLabel ?? "Copied"
      timers.set(
        button,
        setTimeout(() => {
          delete button.dataset.copied
          button.setAttribute("aria-label", button.dataset.copyLabel ?? "Copy")
          if (status) status.textContent = ""
          timers.delete(button)
        }, 2000)
      )
    } catch {
      if (!button.isConnected||requests.get(button)!==request) return
      clearTimeout(timers.get(button))
      timers.delete(button)
      delete button.dataset.copied
      button.setAttribute("aria-label", button.dataset.copyLabel ?? "Copy")
      const target=button.dataset.copyTarget?document.getElementById(button.dataset.copyTarget):button.closest('[data-slot=code-block]')?.querySelector<HTMLElement>('[data-slot=code-block-content]');
      target?.focus();
      if(target){const selection=getSelection(),range=document.createRange();range.selectNodeContents(target.querySelector('code')??target);selection?.removeAllRanges();selection?.addRange(range);}
      if (status) status.textContent = button.dataset.errorLabel ?? "Could not copy"
    }
  })
  document.addEventListener("astro:before-swap", () => {
    for (const timer of timers.values()) clearTimeout(timer)
    timers.clear()
  })
</script>
