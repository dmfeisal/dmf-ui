---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Focusable code supports keyboard scrolling, as in shadcn/ui. */
import type { HTMLAttributes } from "astro/types"

import { cn } from "../utils"

import CodeBlockLine from "./code-block-line.astro"

type Props = HTMLAttributes<"pre"> & {
  code?: string
  wrap?: boolean
  lineNumbers?: boolean
  startLine?: number
}

const {
  class: className,
  code,
  wrap = false,
  lineNumbers = false,
  startLine = 1,
  style,
  ...props
} = Astro.props

const contentStyle =
  typeof style === "string"
    ? `counter-reset: line ${startLine - 1}; ${style}`
    : { counterReset: `line ${startLine - 1}`, ...style }
---

<pre
  data-slot="code-block-content"
  data-wrap={wrap || undefined}
  data-numbered={lineNumbers || undefined}
  dir="ltr"
  tabindex="0"
  style={contentStyle}
  class={cn(
    "px-4 py-4 leading-relaxed group-has-data-[slot=code-block-header]/code-block:pt-2 group-has-data-[slot=code-block-footer]/code-block:pb-2 group-data-[size=sm]/code-block:px-3 group-data-[size=sm]/code-block:py-3 group-data-[size=sm]/code-block:group-has-data-[slot=code-block-header]/code-block:pt-1.5 min-h-0 min-w-0 overflow-auto text-start font-mono outline-none data-wrap:wrap-break-word data-wrap:whitespace-pre-wrap",
    className
  )}
  {...props}
><code data-slot="code-block-code" class="grid min-h-lh min-w-max content-start in-data-numbered:grid-cols-[auto_1fr] in-data-wrap:min-w-0">{code !== undefined ? lineNumbers ? code.replace(/\n$/, "").split("\n").map((line) => <CodeBlockLine>{line}</CodeBlockLine>) : code : <slot />}</code></pre>
