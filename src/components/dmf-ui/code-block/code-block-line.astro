---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "../utils"

const variants = cva(
  "-mx-4 px-4 in-data-numbered:gap-x-3 before:min-w-6 before:text-end before:text-muted-foreground after:start-1 after:text-muted-foreground group-data-[size=sm]/code-block:-mx-3 group-data-[size=sm]/code-block:px-3 relative block min-h-lh before:select-none after:absolute after:top-0 after:select-none in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:[counter-increment:line] in-data-numbered:before:content-[counter(line)] in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']",
  {
    variants: {
      variant: {
        default: "",
        added: "bg-muted after:content-['+']",
        removed: "bg-destructive/10 after:text-destructive after:content-['−']",
        highlighted: "bg-muted",
      },
    },
    defaultVariants: { variant: "default" },
  }
)

type Props = HTMLAttributes<"span"> & VariantProps<typeof variants>
const { class: className, variant = "default", ...props } = Astro.props
---

<span
  data-slot="code-block-line"
  data-variant={variant}
  class={cn(variants({ variant }), className)}
  {...props}
>
  <span data-slot="code-block-line-content" class="min-w-0">
    <slot />
    {"\n"}
  </span>
</span>
