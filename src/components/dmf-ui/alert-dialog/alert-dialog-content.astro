---
import type {HTMLAttributes} from 'astro/types';
import {DialogPortal,DialogOverlay} from '../dialog';
import {cn} from '../utils';
// size="sm" narrows the dialog for short confirmations, as shadcn's sm does.
type Props=HTMLAttributes<'div'> & {size?:'default'|'sm';};
const {size='default',class:className,style,...props}=Astro.props;
---
<DialogPortal><DialogOverlay/><div {...props} data-slot="dialog-content" data-component="alert-dialog-content" data-size={size} hidden class={cn('dmf-alert-dialog-content',className)} style={`z-index:calc(var(--dialog-content-stack-index,0) * 2 + 101);${style??''}`}><slot/></div></DialogPortal>
