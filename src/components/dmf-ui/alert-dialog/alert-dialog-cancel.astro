---
import type {HTMLAttributes} from 'astro/types';
import type {ButtonVariantProps} from '../button/button-variants';
import {Button} from '../button';
// Declared here so the props are part of the component's contract; they go straight to Button, as in shadcn.
type Props=HTMLAttributes<'button'>&ButtonVariantProps&{variant?:ButtonVariantProps['variant'];size?:ButtonVariantProps['size'];};
const {variant,size,...props}=Astro.props;
---
<Button {...props} variant={variant??'outline'} size={size??'default'} type="button" data-slot="dialog-close" autofocus><slot>Cancel</slot></Button>
