---
import type { HTMLAttributes } from "astro/types"

import { cn } from "../utils"

type Props = HTMLAttributes<"div">

const { class: className, ...props } = Astro.props
---

<div
  data-slot="command-list"
  class={cn(
    "no-scrollbar max-h-72 scroll-py-1 outline-none h-[var(--command-list-height)] overflow-x-hidden overflow-y-auto transition-[height] duration-150 ease-out",
    className
  )}
  {...props}
>
  <slot />
</div>
