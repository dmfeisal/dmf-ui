---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
interface Props extends HTMLAttributes<'nav'> {items:{label:string;href:string;current?:boolean;disabled?:boolean}[];label:string;orientation?:'horizontal'|'vertical';}
const {items,label,orientation='horizontal',class:className,...props}=Astro.props;
if(items.filter(item=>item.current&&!item.disabled).length>1)throw new Error('NavigationMenu supports one current page per navigation.');
---
<nav data-slot="navigation-menu" aria-label={label} data-orientation={orientation} class={cn('dmf-navigation-menu',className)} {...props}><ul>{items.map(item=><li>{item.disabled?<span aria-disabled="true">{item.label}</span>:<a href={item.href} aria-current={item.current?'page':undefined}>{item.label}</a>}</li>)}</ul></nav>
