---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "../utils"

type Props = VariantProps<typeof variants> & HTMLAttributes<"div">

const variants = cva("grid min-w-0 gap-0.5 rounded-lg border px-4 py-3 text-start text-sm has-[>svg]:grid-cols-[auto_minmax(0,1fr)] has-[>svg]:gap-x-2.5 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4 group/alert relative w-full [overflow-wrap:anywhere]", {
  variants: {
    variant: {
      default: "border-border bg-card text-card-foreground",
      destructive: "border-border text-destructive bg-card *:data-[slot=alert-description]:text-destructive *:[svg]:text-current",
    },
  },
  defaultVariants: {
    variant: "default",
  },
})

const { class: className, variant, ...props } = Astro.props
---

<div
  data-slot="alert"
  role="note"
  data-variant={variant ?? 'default'}
  class={cn(variants({ variant }), className)}
  {...props}
>
  <slot />
</div>
