---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'button'>;
const {class:className,...props}=Astro.props;
---
<button {...props} type="button" data-slot="sidebar-group-action" class={cn('text-sidebar-foreground hover:bg-sidebar-accent absolute end-3 top-3.5 flex aspect-square w-5 items-center justify-center rounded-md p-0 outline-hidden [&>svg]:size-4 [&>svg]:shrink-0',className)}><slot/></button>
