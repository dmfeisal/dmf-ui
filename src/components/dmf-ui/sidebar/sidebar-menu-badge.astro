---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'div'>;
const {class:className,...props}=Astro.props;

---
<div {...props} data-slot="sidebar-menu-badge" class={cn('text-sidebar-foreground pointer-events-none absolute end-1 flex h-5 min-w-5 items-center justify-center rounded-md px-1 text-xs font-medium tabular-nums select-none',className)}><slot/></div>
