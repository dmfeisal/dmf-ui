---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'ul'>;
const {class:className,...props}=Astro.props;

---
<ul {...props} data-slot="sidebar-menu-sub" class={cn('border-sidebar-border mx-3.5 flex min-w-0 translate-x-px list-none flex-col gap-1 border-l px-2.5 py-0.5',className)}><slot/></ul>
