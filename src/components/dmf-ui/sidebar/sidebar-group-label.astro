---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'div'>;
const {class:className,...props}=Astro.props;

---
<div {...props} data-slot="sidebar-group-label" class={cn('text-sidebar-foreground/70 flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium outline-hidden',className)}><slot/></div>
