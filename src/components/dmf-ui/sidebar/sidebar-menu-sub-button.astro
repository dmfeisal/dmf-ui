---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'a'>&{href?:string;isActive?:boolean;size?:'sm'|'md';};
const {class:className,isActive=false,size='md',...props}=Astro.props;
// A link inside a SidebarMenuSub. isActive marks the current page with aria-current and data-active.
---
<a {...props} data-slot="sidebar-menu-sub-button" data-size={size} data-active={isActive?'':undefined} aria-current={isActive?'page':undefined} class={cn('text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground data-active:bg-sidebar-accent data-active:text-sidebar-accent-foreground flex h-7 min-w-0 -translate-x-px items-center gap-2 overflow-hidden rounded-md px-2 outline-hidden focus-visible:ring-2 [&>svg]:size-4 [&>svg]:shrink-0',size==='sm'?'text-xs':'text-sm',className)}><slot/></a>
