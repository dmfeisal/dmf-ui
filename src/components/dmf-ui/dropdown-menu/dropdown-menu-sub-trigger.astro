---
import type { HTMLAttributes } from "astro/types"
import ChevronRightIcon from "@lucide/astro/icons/chevron-right"

import { cn } from "../utils"

type Props = HTMLAttributes<"button"> & {
  disabled?: boolean
  inset?: boolean
}

const { class: className, type = "button", disabled, inset, ...props } = Astro.props
// The item that opens its submenu. It is a menu item, so the parent menu's arrow keys move past it.
---

<button
  type={type}
  role="menuitem"
  aria-haspopup="menu"
  aria-expanded="false"
  aria-disabled={disabled ? "true" : undefined}
  disabled={disabled ? true : undefined}
  tabindex="-1"
  data-slot="dropdown-menu-sub-trigger"
  data-inset={inset || undefined}
  class={cn(
    "data-highlighted:bg-accent data-highlighted:text-accent-foreground focus-visible:bg-accent aria-expanded:bg-accent gap-2 rounded-md py-1 pe-2 ps-1.5 text-sm data-inset:ps-8 [&_svg:not([class*='size-'])]:size-4 relative flex w-full cursor-default items-center outline-hidden select-none aria-disabled:pointer-events-none aria-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <slot />
  <ChevronRightIcon class="ms-auto text-muted-foreground" aria-hidden="true" />
</button>
