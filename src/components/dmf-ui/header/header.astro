---
import type { HTMLAttributes } from "astro/types"
import { cva, type VariantProps } from "class-variance-authority"

import { cn } from "../utils"

type Props = HTMLAttributes<"header"> & VariantProps<typeof variants>

const variants = cva("py-2 relative z-50 flex w-full items-center gap-4", {
  variants: {
    variant: {
      default: "",
      floating:
        "my-2 rounded-lg border bg-background shadow-sm mx-auto w-[calc(100%-2*var(--gutter,--spacing(4)))] max-w-[calc(var(--container,var(--container-7xl))-2*var(--gutter,--spacing(4)))] overflow-hidden",
    },
  },
  defaultVariants: {
    variant: "default",
  },
})

const {
  class: className,
  variant = "default",
  "data-slot": dataSlot = "header",
  ...props
} = Astro.props
---

<header
  class={cn(variants({ variant }), className)}
  data-slot={dataSlot}
  data-variant={variant}
  {...props}
>
  <slot />
</header>
