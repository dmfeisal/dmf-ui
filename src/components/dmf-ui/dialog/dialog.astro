---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div"> & {
  defaultOpen?: boolean
  closeOnClickOutside?: boolean
  closeOnEscape?: boolean
  lockScroll?: boolean
  alertDialog?: boolean
}

const {
  class: className,
  defaultOpen,
  closeOnClickOutside,
  closeOnEscape,
  lockScroll,
  alertDialog,
  ...props
} = Astro.props
---

<div
  data-slot="dialog"
  data-dmf-dialog
  data-default-open={defaultOpen}
  data-close-on-click-outside={closeOnClickOutside}
  data-close-on-escape={closeOnEscape}
  data-lock-scroll={lockScroll}
  data-alert-dialog={alertDialog}
  class={className}
  {...props}
>
  <slot />
</div>

<script>
  import { createDialog, type DialogController } from "@data-slot/dialog";
  const controllers: DialogController[] = [];
  const initialize = () => {
    if (controllers.length) return;
    document.querySelectorAll<HTMLElement>("[data-dmf-dialog]").forEach(root => controllers.push(createDialog(root)));
  };
  initialize();
  document.addEventListener("astro:page-load", initialize);
  document.addEventListener("astro:before-swap", () => { controllers.splice(0).forEach(c => c.destroy()); });
</script>
