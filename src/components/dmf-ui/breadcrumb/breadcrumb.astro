---
import type {HTMLAttributes} from 'astro/types';
import {ChevronRight} from '@lucide/astro';
import {cn} from '../utils';
interface Props extends HTMLAttributes<'nav'> {items:{label:string;href?:string}[];label?:string;}
const {items,label='Breadcrumb',class:className,...props}=Astro.props;
---
<nav data-slot="breadcrumb" aria-label={label} class={cn('dmf-breadcrumb',className)} {...props}><ol>{items.map((item,index)=><li>{index>0&&<ChevronRight size={14} aria-hidden="true"/>}{index===items.length-1?<span aria-current="page">{item.label}</span>:item.href?<a href={item.href}>{item.label}</a>:<span>{item.label}</span>}</li>)}</ol></nav>
