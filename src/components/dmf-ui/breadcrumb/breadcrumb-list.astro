---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'ol'>;
const {class:className,...props}=Astro.props;
---
<ol {...props} data-slot="breadcrumb-list" class={cn('text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5',className)}><slot/></ol>
