---
import type {HTMLAttributes} from 'astro/types';
import {Input} from '../input';
import {cn} from '../utils';
type Props=HTMLAttributes<'input'>;
const {class:className,...props}=Astro.props;
---
<Input data-slot="input-group-control" {...props} class={cn('flex-1 rounded-none border-0 bg-transparent shadow-none ring-0 focus-visible:ring-0 disabled:bg-transparent aria-invalid:ring-0 dark:bg-transparent dark:disabled:bg-transparent',className)}/>
