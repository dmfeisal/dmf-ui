---
import type {HTMLAttributes} from 'astro/types';
import type {NavigationIcon,Presentation} from '../navigation-types';
import {cn} from '../utils';
import ToggleGroupItem from './toggle-group-item.astro';
interface Props extends HTMLAttributes<'div'> {label:string;items?:{value:string;label:string;icon?:NavigationIcon;disabled?:boolean}[];type?:'single'|'multiple';defaultValue?:string[];disabled?:boolean;presentation?:Presentation;variant?:'default'|'outline';size?:'default'|'sm'|'lg';spacing?:number;orientation?:'horizontal'|'vertical';}
const {label,items,type='single',defaultValue=[],disabled=false,presentation='label',variant='outline',size='default',spacing=2,orientation='horizontal',class:className,style,...props}=Astro.props;
if(items){
 if(new Set(items.map(item=>item.value)).size!==items.length||items.some(item=>!item.value))throw new Error('ToggleGroup requires unique nonempty item values.');
 if(type==='single'&&defaultValue.length>1)throw new Error('Single ToggleGroup accepts at most one initial selection.');
 if(defaultValue.some(value=>!items.some(item=>item.value===value)))throw new Error('ToggleGroup defaultValue must reference an item.');
}
if(!Number.isFinite(spacing)||spacing<0)throw new Error('ToggleGroup spacing must be a finite number of spacing steps, 0 or more.');
---
<div {...props} data-slot="toggle-group" role="group" aria-label={label} data-type={type} data-presentation={presentation} data-variant={variant} data-size={size} data-spacing={spacing} data-orientation={orientation} style={`--gap:${spacing};${style??''}`} class={cn('group/toggle-group flex w-fit flex-row flex-wrap items-center gap-[--spacing(var(--gap))] rounded-lg data-[size=sm]:rounded-[min(calc(var(--radius)*.8),10px)] data-vertical:flex-col data-vertical:items-stretch',className)}>{items?items.map(item=><ToggleGroupItem label={item.label} value={item.value} icon={item.icon} disabled={disabled||item.disabled} defaultPressed={defaultValue.includes(item.value)} presentation={presentation} variant={variant} size={size}/>):<slot/>}</div>
