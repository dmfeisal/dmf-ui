---
import type {HTMLAttributes} from 'astro/types';
import type {NavigationIcon,Presentation} from '../navigation-types';
import Content from '../navigation-content.astro';
import {cn} from '../utils';
import {toggleVariants} from './toggle-variants';
interface Props extends Omit<HTMLAttributes<'button'>,'type'|'value'|'aria-pressed'> {label:string;value?:string;defaultPressed?:boolean;icon?:NavigationIcon;presentation?:Presentation;variant?:'default'|'outline';size?:'default'|'sm'|'lg';tooltipTrigger?:boolean;slotName?:string;}
const {label,value,defaultPressed=false,icon:Icon,presentation='label',variant='default',size='default',tooltipTrigger=false,slotName='toggle',disabled=false,class:className,...props}=Astro.props;
---
<button {...props} type="button" data-slot={tooltipTrigger?'tooltip-trigger':slotName} data-dmf-toggle data-value={value} data-default-pressed={String(defaultPressed)} data-toggle-disabled={String(disabled)} data-variant={variant} data-size={size} data-presentation={presentation} disabled aria-pressed={defaultPressed?'true':'false'} class={cn(toggleVariants({variant,size}),className)}><Content label={label} icon={Icon} presentation={presentation}/></button>
<script>import './runtime';</script>
