---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'span'>;
const {class:className,...props}=Astro.props;
// A status mark on the avatar's corner, decorative for assistive technology.
---
<span {...props} data-slot="avatar-badge" aria-hidden="true" class={cn('bg-primary text-primary-foreground ring-background absolute end-0 bottom-0 flex size-2.5 items-center justify-center rounded-full ring-2 select-none',className)}><slot/></span>
