---
import type {HTMLAttributes} from 'astro/types';
import {cn} from '../utils';
type Props=HTMLAttributes<'div'>;
const {class:className,...props}=Astro.props;
---
<div {...props} data-slot="avatar-group" class={cn('*:data-[slot=avatar]:ring-background group flex -space-x-2 *:data-[slot=avatar]:ring-2',className)}><slot/></div>
