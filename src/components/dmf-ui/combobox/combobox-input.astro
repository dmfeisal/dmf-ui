---
import type {HTMLAttributes} from 'astro/types';
import {X} from '@lucide/astro';
import {InputGroup,InputGroupAddon,InputGroupButton,InputGroupInput} from '../input-group';
import {cn} from '../utils';
import ComboboxTrigger from './combobox-trigger.astro';
interface Props extends Omit<HTMLAttributes<'input'>,'type'|'role'> {showTrigger?:boolean;showClear?:boolean;}
const {showTrigger=true,showClear=false,class:className,id,required,...props}=Astro.props;
// Disabled until the runtime enhances it, as the rest of the enhanced view is hidden without JavaScript.
---
<InputGroup class={cn('w-auto',className)}>
 <InputGroupInput id={id} type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off" spellcheck="false" disabled required={required} {...props}/>
 {(showTrigger||showClear)&&<InputGroupAddon align="inline-end">
  {showTrigger&&<ComboboxTrigger inInput/>}
  {showClear&&<InputGroupButton variant="ghost" size="icon-xs" data-slot="combobox-clear" data-combobox-clear aria-label="Clear selection" disabled hidden><X class="pointer-events-none" aria-hidden="true"/></InputGroupButton>}
 </InputGroupAddon>}
</InputGroup>
