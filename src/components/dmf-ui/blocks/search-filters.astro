---
import type {HTMLAttributes} from 'astro/types';
import {Field,FieldLabel} from '../field';
import {Input} from '../input';
import {NativeSelect,NativeSelectOption} from '../native-select';
import {Checkbox} from '../checkbox';
import {Button} from '../button';
import {Alert,AlertDescription} from '../alert';
import {cn} from '../utils';
interface Props extends Omit<HTMLAttributes<'form'>,'id'|'action'|'method'|'title'> {
 id:string;action:string;title?:string;headingLevel?:'h1'|'h2'|'h3';
 query?:string;queryName?:string;queryLabel?:string;queryRequired?:boolean;
 options:{value:string;label:string;disabled?:boolean}[];selectedValue?:string;choiceName?:string;choiceLabel?:string;allLabel?:string;
 filters?:{name:string;label:string;value?:string;checked?:boolean;disabled?:boolean}[];
 submitLabel?:string;resetLabel?:string;pending?:boolean;disabled?:boolean;submitDisabled?:boolean;error?:string;
}
const {id,action,title='Search and filter',headingLevel:Heading='h2',query='',queryName='q',queryLabel='Search',queryRequired=false,options,selectedValue='',choiceName='category',choiceLabel='Category',allLabel='All categories',filters=[],submitLabel='Apply filters',resetLabel='Reset filters',pending=false,disabled=false,submitDisabled=false,error,class:className,...props}=Astro.props;
if(!id?.trim()||!action?.trim()||!queryName.trim()||!choiceName.trim()||queryName===choiceName)throw Error('SearchFiltersBlock needs an id, host action and distinct field names.');
if(new Set(options.map(o=>o.value)).size!==options.length||options.some(o=>!o.value||!o.label.trim())||(selectedValue&&!options.some(o=>o.value===selectedValue&&!o.disabled)))throw Error('SearchFiltersBlock options need unique nonempty values/labels and an enabled initial choice.');
if(filters.some(f=>!f.name.trim()||!f.label.trim()||[queryName,choiceName].includes(f.name)))throw Error('Filter names must not collide with query or choice fields.');
---
<form {...props} id={id} action={action} method="get" aria-labelledby={`${id}-title`} aria-busy={pending?'true':undefined} data-slot="search-filters-block" class={cn('dmf-block dmf-search-filters-block',className)}>
 <Heading id={`${id}-title`}>{title}</Heading>
 {error&&<Alert variant="destructive" role="alert"><AlertDescription>{error}</AlertDescription></Alert>}
 <fieldset disabled={disabled||pending} class="dmf-block-fields"><legend class="sr-only">{title}</legend>
  <div class="dmf-block-filter-grid"><Field><FieldLabel for={`${id}-query`}>{queryLabel}</FieldLabel><Input type="search" id={`${id}-query`} name={queryName} value={query} required={queryRequired}/></Field><Field><FieldLabel for={`${id}-choice`}>{choiceLabel}</FieldLabel><NativeSelect id={`${id}-choice`} name={choiceName}><NativeSelectOption value="" selected={!selectedValue}>{allLabel}</NativeSelectOption>{options.map(option=><NativeSelectOption value={option.value} selected={option.value===selectedValue} disabled={option.disabled}>{option.label}</NativeSelectOption>)}</NativeSelect></Field></div>
  {filters.length>0&&<div class="dmf-block-filter-options">{filters.map((filter,index)=><label for={`${id}-filter-${index}`}><Checkbox id={`${id}-filter-${index}`} name={filter.name} value={filter.value??'on'} checked={filter.checked} disabled={filter.disabled}/><span>{filter.label}</span></label>)}</div>}
  <slot name="filters"/>
  <div class="dmf-block-actions"><Button type="submit" disabled={submitDisabled} data-block-submit>{submitLabel}</Button><Button type="reset" variant="outline">{resetLabel}</Button></div>
 </fieldset>
 <p role="status" data-block-pending class="sr-only">{pending?'Updating results…':''}</p><slot/>
</form>
