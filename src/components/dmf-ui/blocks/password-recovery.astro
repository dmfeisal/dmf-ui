---
import type {HTMLAttributes} from 'astro/types';
import {Card,CardHeader,CardContent,CardFooter} from '../card';
import {Field,FieldLabel,FieldError} from '../field';
import {Input} from '../input';
import {LoadingButton} from '../loading-button';
import {Alert,AlertTitle,AlertDescription} from '../alert';
import {cn} from '../utils';
interface Props extends Omit<HTMLAttributes<'form'>,'id'|'method'|'action'|'title'> {
 id:string;action:string;title?:string;description?:string;headingLevel?:'h1'|'h2'|'h3';
 email?:string;emailName?:string;emailLabel?:string;submitLabel?:string;pendingLabel?:string;
 pending?:boolean;disabled?:boolean;submitDisabled?:boolean;complete?:boolean;completionMessage?:string;
 error?:string;errorTitle?:string;fieldErrors?:{email?:string};signinHref?:string;signinLabel?:string;
}
const {id,action,title='Request password recovery',description='Enter your email to request recovery instructions.',headingLevel:Heading='h2',email='',emailName='email',emailLabel='Email',submitLabel='Request recovery',pendingLabel='Requesting recovery…',pending=false,disabled=false,submitDisabled=false,complete=false,completionMessage='If recovery is available for this address, follow the instructions provided by your account service.',error,errorTitle='Unable to complete the request',fieldErrors={},signinHref,signinLabel='Return to sign in',class:className,...props}=Astro.props;
if(!id?.trim()||!action?.trim()||!emailName.trim())throw Error('PasswordRecoveryBlock needs an id, host action and email field name.');
---
<form {...props} id={id} action={action} method="post" aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`} aria-busy={pending?'true':undefined} data-slot="password-recovery-block" class={cn('dmf-block dmf-auth-block',className)}>
 <Card><CardHeader><Heading id={`${id}-title`}>{title}</Heading><p id={`${id}-description`}>{description}</p></CardHeader><CardContent>
  {error&&<Alert variant="destructive" role="alert"><AlertTitle>{errorTitle}</AlertTitle><AlertDescription>{error}</AlertDescription></Alert>}
  <p id={`${id}-completion`} role="status" aria-atomic="true" tabindex={complete?-1:undefined} data-recovery-completion>{complete?completionMessage:''}</p>
  {!complete&&<fieldset disabled={disabled||pending} class="dmf-block-fields"><legend class="sr-only">{title}</legend>
   <Field data-invalid={fieldErrors.email?'true':undefined}><FieldLabel for={`${id}-email`}>{emailLabel}</FieldLabel><Input id={`${id}-email`} name={emailName} type="email" autocomplete="email" value={email} required aria-invalid={fieldErrors.email?'true':undefined} aria-describedby={fieldErrors.email?`${id}-email-error`:undefined}/><FieldError id={`${id}-email-error`} errors={[{message:fieldErrors.email}]}/></Field>
   <slot name="fields"/>
   <LoadingButton type="submit" label={submitLabel} loadingLabel={pendingLabel} loading={pending} disabled={disabled||submitDisabled} presentation="icon-label" class="w-full" data-block-submit/>
  </fieldset>}
  <slot/>
 </CardContent>{(signinHref||Astro.slots.has('footer'))&&<CardFooter>{signinHref&&<a href={signinHref}>{signinLabel}</a>}<slot name="footer"/></CardFooter>}</Card>
</form>
