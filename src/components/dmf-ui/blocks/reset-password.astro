---
import type {HTMLAttributes} from 'astro/types';
import {Card,CardHeader,CardContent,CardFooter} from '../card';
import {Field,FieldLabel,FieldDescription,FieldError} from '../field';
import {Input} from '../input';
import {LoadingButton} from '../loading-button';
import {Alert,AlertTitle,AlertDescription} from '../alert';
import {cn} from '../utils';
interface Props extends Omit<HTMLAttributes<'form'>,'id'|'method'|'action'|'title'> {
 id:string; action:string; title?:string; description?:string; headingLevel?:'h1'|'h2'|'h3';
 passwordName?:string; passwordLabel?:string; credentialState?:'unverified'|'ready'|'invalid'|'expired';
 complete?:boolean; completionMessage?:string; unverifiedMessage?:string; invalidMessage?:string; expiredMessage?:string;
 passwordHelp?:string; submitLabel?:string; pendingLabel?:string; pending?:boolean; disabled?:boolean; submitDisabled?:boolean;
 error?:string; errorTitle?:string; fieldErrors?:{password?:string;confirmPassword?:string};
 confirmPassword?:boolean; confirmPasswordName?:string; confirmPasswordLabel?:string; signinHref?:string; signinLabel?:string; recoveryHref?:string; recoveryLabel?:string;
}
const {id,action,title='Choose a new password',description='Use this form after your account service validates your recovery link.',headingLevel:Heading='h2',passwordName='password',passwordLabel='New password',credentialState='unverified',complete=false,completionMessage='Follow your account service’s sign-in instructions.',unverifiedMessage='Your account service must validate your recovery link before you enter a new password.',invalidMessage='This recovery link cannot be used. Request new recovery instructions.',expiredMessage='This recovery link has expired. Request new recovery instructions.',passwordHelp,submitLabel='Update password',pendingLabel='Updating password…',pending=false,disabled=false,submitDisabled=false,error,errorTitle='Unable to update password',fieldErrors={},confirmPassword=false,confirmPasswordName='confirmPassword',confirmPasswordLabel='Confirm password',signinHref,signinLabel='Sign in',recoveryHref,recoveryLabel='Request new recovery instructions',class:className,...props}=Astro.props;
if(!id?.trim()||!action?.trim()||!passwordName.trim()||(confirmPassword&&(!confirmPasswordName.trim()||passwordName===confirmPasswordName)))throw Error('ResetPasswordBlock needs an id, host action and distinct field names.');
if(!['unverified','ready','invalid','expired'].includes(credentialState))throw Error('Unsupported ResetPasswordBlock credentialState.');
const ready=credentialState==='ready'&&!complete;
const status=complete?completionMessage:credentialState==='ready'?'':credentialState==='expired'?expiredMessage:credentialState==='invalid'?invalidMessage:unverifiedMessage;
---
<form {...props} id={id} action={action} method="post" aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`} aria-busy={pending&&ready?'true':undefined} data-slot="reset-password-block" class={cn('dmf-block dmf-auth-block dmf-reset-password-block',className)}>
 <Card><CardHeader><Heading id={`${id}-title`}>{title}</Heading><p id={`${id}-description`}>{description}</p></CardHeader><CardContent>
  {error&&<Alert variant="destructive" role="alert"><AlertTitle>{errorTitle}</AlertTitle><AlertDescription>{error}</AlertDescription></Alert>}
  <p id={`${id}-status`} role="status" aria-atomic="true" tabindex={!ready?-1:undefined} data-reset-status>{status}</p>
  {ready&&<fieldset disabled={disabled||pending} class="dmf-block-fields"><legend class="sr-only">{title}</legend>
   <Field data-invalid={fieldErrors.password?'true':undefined}><FieldLabel for={`${id}-password`}>{passwordLabel}</FieldLabel><Input id={`${id}-password`} name={passwordName} type="password" autocomplete="new-password" required aria-invalid={fieldErrors.password?'true':undefined} aria-describedby={[passwordHelp?`${id}-password-help`:'',fieldErrors.password?`${id}-password-error`:''].filter(Boolean).join(' ')||undefined}/>{passwordHelp&&<FieldDescription id={`${id}-password-help`}>{passwordHelp}</FieldDescription>}<FieldError id={`${id}-password-error`} errors={[{message:fieldErrors.password}]}/></Field>
   {confirmPassword&&<>   <Field data-invalid={fieldErrors.confirmPassword?'true':undefined}><FieldLabel for={`${id}-confirm-password`}>{confirmPasswordLabel}</FieldLabel><Input id={`${id}-confirm-password`} name={confirmPasswordName} type="password" autocomplete="new-password" required aria-invalid={fieldErrors.confirmPassword?'true':undefined} aria-describedby={fieldErrors.confirmPassword?`${id}-confirm-password-error`:undefined}/><FieldError id={`${id}-confirm-password-error`} errors={[{message:fieldErrors.confirmPassword}]}/></Field></>}
   <slot name="fields"/>
   <LoadingButton type="submit" label={submitLabel} loadingLabel={pendingLabel} loading={pending} disabled={disabled||submitDisabled} presentation="icon-label" class="w-full" data-block-submit/>
  </fieldset>}
  <slot/>
 </CardContent>{(signinHref||recoveryHref||Astro.slots.has('footer'))&&<CardFooter>{signinHref&&<a href={signinHref}>{signinLabel}</a>}{recoveryHref&&<a href={recoveryHref}>{recoveryLabel}</a>}<slot name="footer"/></CardFooter>}</Card>
</form>
