---
import type { HTMLAttributes } from "astro/types"
import CheckIcon from "@lucide/astro/icons/check"

import { cn } from "../utils"

type Props = HTMLAttributes<"div"> & {
  value?: string
  disabled?: boolean
  label?: string
}

const { class: className, value, disabled, label, ...props } = Astro.props
---

<div
  data-slot="select-item"
  data-value={value}
  data-disabled={disabled ? "true" : undefined}
  data-label={label}
  class={cn(
    "data-highlighted:bg-accent data-highlighted:text-accent-foreground not-data-[variant=destructive]:data-highlighted:**:text-accent-foreground gap-2 rounded-sm py-1.5 pe-8 ps-2 text-sm [&_svg:not([class*='size-'])]:size-4 *:data-[slot=select-item-text]:flex *:data-[slot=select-item-text]:items-center *:data-[slot=select-item-text]:gap-2 group/select-item data-highlighted:**:[svg]:text-accent-foreground relative flex w-full cursor-default items-center outline-hidden select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 *:data-[slot=select-item-text]:shrink-0 *:data-[slot=select-item-text]:whitespace-nowrap [&_svg]:pointer-events-none [&_svg]:shrink-0",
    className
  )}
  {...props}
>
  <span
    data-slot="select-item-text"
    class="flex flex-1 gap-2 shrink-0 items-center whitespace-nowrap"
  >
    <slot />
  </span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute end-2 flex size-4 items-center justify-center opacity-0 group-data-selected/select-item:opacity-100"
  >
    <CheckIcon />
  </span>
</div>
