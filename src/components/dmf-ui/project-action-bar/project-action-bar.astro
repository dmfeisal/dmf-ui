---
import type {HTMLAttributes} from 'astro/types';
import {ArrowDown,ArrowUpRight} from '@lucide/astro';
import Link from '../navigation-link.astro';
import type {NavigationIcon,Presentation} from '../navigation-types';
import {cn} from '../utils';
interface Props extends HTMLAttributes<'nav'> {label:string;ariaLabel:string;items:{href:string;label:string;emphasis?:'primary'|'secondary';direction?:'down'|'external';icon?:NavigationIcon}[];presentation?:Presentation;}
const {label,ariaLabel,items,presentation='icon-label',class:className,...props}=Astro.props;
---
<nav data-slot="project-action-bar" aria-label={ariaLabel} data-presentation={presentation} class={cn('dmf-project-actions',className)} {...props}><p>{label}</p><div>{items.map(item=><div data-action-emphasis={item.emphasis??'secondary'}><Link item={{...item,icon:item.icon??(item.direction==='down'?ArrowDown:ArrowUpRight)}} presentation={presentation} side="inline-end"/></div>)}</div></nav>
