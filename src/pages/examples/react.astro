---
import '../../styles/docs.css';
import '../../../packages/react/styles.css';
import {renderProof} from '../../../packages/react/tests/server';
const html=renderProof();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>React adapter proof | DMF UI</title></head><body><main class="dmf-ui react-proof-page"><nav aria-label="Breadcrumb"><ol><li><a href="../../">DMF UI</a></li><li aria-current="page">React proof</li></ol></nav><h1>React adapter alpha</h1><p>Twelve experimental web component families, including Field and Card composition. React Native and SwiftUI remain planned.</p><div id="react-proof" set:html={html}></div><button id="react-unmount" type="button">Unmount React proof</button><p id="react-lifecycle" role="status">Server rendered; React hydrates this form.</p></main><script>import {mountProof} from '../../../packages/react/tests/browser'; mountProof();</script></body></html>
<style is:global>
html{font-size:87.5%}body{margin:0}.react-proof-page fieldset{display:grid;gap:16px}.react-proof-page legend{margin-bottom:16px}
.react-proof-page{max-width:52rem;margin:0 auto;padding:32px 20px;min-height:100svh}.react-proof-page h1{font-size:2rem;margin:24px 0 12px}.react-proof-page>p{margin-bottom:24px}.react-proof-page form{display:grid;gap:16px}.dmf-react-actions{display:flex;gap:12px;flex-wrap:wrap}.react-proof-page #react-unmount{margin-top:24px;padding:12px;border:1px solid var(--border);border-radius:var(--radius);outline-offset:3px}.react-proof-page #react-lifecycle{margin-top:12px}
</style>
