---
import NavigationIcon from '../../components/docs/NavigationIcon.astro';
import {NativeSelect} from '../../components/dmf-ui/native-select';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import {components,categories,collections} from '../../data/documentation';
import {implementationSupport} from '../../data/support';
---
<DocumentationLayout title="Components" description="Browse implemented components by responsibility and secondary domain collections." section="components" crumbs={[{name:'Components'}]}>
<h1>Components</h1><p class="docs-lead">One canonical page per component, organized by responsibility. Domain collections identify reusable building blocks for a workflow; they do not imply a complete product or native-platform implementation.</p>
<p class="docs-note"><a href="/docs/component-taxonomy/">Grouping and naming rules</a>. <a href="/docs/icons/">Browse interface icons</a>.</p>
<div class="docs-search"><label for="component-search">Find a component</label><input type="search" id="component-search" placeholder="Search by name, purpose or collection" autocomplete="off" aria-controls="component-catalog" disabled/><output id="component-count" role="status" aria-live="polite">{components.length} components</output></div>
<fieldset class="catalog-filters" data-taxonomy-controls hidden><legend>Filter components</legend><div class="catalog-filter"><label for="component-category">Responsibility</label><NativeSelect id="component-category" aria-controls="component-catalog"><option value="">All responsibilities</option>{categories.map(category=><option>{category}</option>)}</NativeSelect></div><div class="catalog-filter"><label for="component-collection">Domain collection</label><NativeSelect id="component-collection" aria-controls="component-catalog"><option value="">All collections</option>{collections.map(domain=><option>{domain}</option>)}</NativeSelect></div><button id="component-reset" type="button">Clear filters</button></fieldset>
<noscript><p class="docs-note">All components and their categories are listed below. Interactive filtering requires JavaScript.</p></noscript>
<div id="component-catalog">{categories.map(category=><section class="docs-section" data-component-category={category}><h2>{category}</h2><div class="docs-grid">{components.filter(item=>item.category===category).map(item=><article class="docs-entry" data-component-entry data-category={item.category} data-domains={JSON.stringify(item.domains)} data-search={`${item.name} ${item.slug} ${item.description} ${item.category} ${item.domains.join(' ')}`.toLowerCase()}><a href={`/components/${item.slug}/`}><NavigationIcon name={item.slug} size={20}/><span>{item.name}</span></a><p>{item.description}</p><p class="catalog-domains">{item.domains.join(' · ')||'Shared interface building block'}</p><p class="catalog-domains" data-support-summary>Astro: experimental · React: {implementationSupport(item.slug).react.status==='experimental'?'experimental':'not implemented'}</p></article>)}</div></section>)}</div><p id="component-empty" class="docs-note docs-empty" hidden>No components match. Change or clear the filters.</p>
</DocumentationLayout>
<style>.catalog-filters{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;border:0;padding:0;margin-block:1rem;min-inline-size:0}.catalog-filters legend{font-size:.875rem;font-weight:600;margin-block-end:.5rem}.catalog-filter{display:grid;gap:.375rem;max-inline-size:100%;font-size:.875rem}.catalog-filter :global([data-slot=native-select-wrapper]){max-inline-size:100%}.catalog-filters button{padding:.375rem .75rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--background);color:var(--foreground)}.catalog-filters button:focus-visible{outline:2px solid var(--foreground);outline-offset:3px}.catalog-domains{font-size:.75rem;color:var(--muted-foreground)}</style>
<script>
 const search=document.querySelector<HTMLInputElement>('#component-search')!,category=document.querySelector<HTMLSelectElement>('#component-category')!,collection=document.querySelector<HTMLSelectElement>('#component-collection')!,reset=document.querySelector<HTMLButtonElement>('#component-reset')!;
 const entries=[...document.querySelectorAll<HTMLElement>('[data-component-entry]')].map(element=>({element,domains:JSON.parse(element.dataset.domains!) as string[]}));
 const update=()=>{const query=search.value.trim().toLowerCase();let count=0;for(const {element,domains}of entries){element.hidden=!(element.dataset.search?.includes(query)&&(!category.value||element.dataset.category===category.value)&&(!collection.value||domains.includes(collection.value)));if(!element.hidden)count++;}for(const group of document.querySelectorAll<HTMLElement>('[data-component-category]'))group.hidden=![...group.querySelectorAll<HTMLElement>('[data-component-entry]')].some(item=>!item.hidden);document.querySelector('#component-count')!.textContent=`${count} ${count===1?'component':'components'}`;document.querySelector<HTMLElement>('#component-empty')!.hidden=count!==0;};
 const controller=new AbortController(),options={signal:controller.signal};
 search.disabled=false;document.querySelector<HTMLFieldSetElement>('[data-taxonomy-controls]')!.hidden=false;
 search.addEventListener('input',update,options);category.addEventListener('change',update,options);collection.addEventListener('change',update,options);reset.addEventListener('click',()=>{search.value='';category.value='';collection.value='';update();search.focus();},options);document.addEventListener('astro:before-swap',()=>controller.abort(),{once:true});
</script>
