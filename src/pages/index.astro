---
import DocumentationLayout from '../layouts/DocumentationLayout.astro';
import {HeroBlock} from '../components/dmf-ui/blocks';
import {MerchantCard} from '../components/dmf-ui/merchant-card';
import {Button} from '../components/dmf-ui/button';
import {CodeSnippet} from '../components/dmf-ui/code-block';
import {supportCounts} from '../data/support';
import {blocks} from '../data/blocks';
import {merchantCardIcons,merchantCardReference} from '../data/merchant-card-reference';
import {getImage} from 'astro:assets';
import first from '../assets/examples/merchant-card/photo-1.png';
import second from '../assets/examples/merchant-card/photo-2.png';
import third from '../assets/examples/merchant-card/photo-3.png';
const images=await Promise.all([first,second,third].map(src=>getImage({src,width:220,height:220,fit:'cover',format:'webp',quality:80})));
const photos=images.map((image,index)=>({src:image.src,alt:merchantCardReference.photos[index].alt}));
---
<DocumentationLayout title="DMF UI" description="Components, composed Blocks and multi-brand foundations for Astro and an experimental React web adapter." section="home">
<div class="m5-home">
 <HeroBlock id="home-introduction" class="docs-hero" title="Build interfaces across products and brands." description="Reusable components, composed Blocks and shared design foundations for web experiences. Start with Astro source or evaluate the separate React web alpha." layout="split">
  <div slot="actions" class="docs-actions"><Button as="a" href="/components/" class="no-underline">Explore components</Button><Button as="a" href="/blocks/" variant="outline" class="no-underline">Browse Blocks</Button></div>
  <p class="docs-note">Experimental · {supportCounts.astroComponents} Astro component families · {supportCounts.astroBlocks} Astro Blocks. React covers {supportCounts.reactComponents} families and {supportCounts.reactBlocks} Blocks.</p>
  <figure slot="media" style="margin:0"><MerchantCard id="home-merchant-card" name={merchantCardReference.name} href="/components/merchant-card/" headingLevel="h2" photos={photos} icons={merchantCardIcons} cuisines={merchantCardReference.cuisines}/><figcaption>Working MerchantCard component. Supplied design imagery and copy, not live merchant information.</figcaption></figure>
 </HeroBlock>
 <section class="docs-section" aria-labelledby="home-start"><h2 id="home-start">Choose a starting point</h2><div class="docs-grid"><article class="docs-entry"><a href="/docs/foundations/">Foundations</a><p>Use shared color, type, spacing, layout and interaction rules with explicit brand boundaries.</p></article><article class="docs-entry"><a href="/components/">Components</a><p>Find a local UI contract by responsibility or domain. Check its actual Astro and React support.</p></article><article class="docs-entry"><a href="/blocks/">Blocks</a><p>Compose sections from existing components. Your application owns destinations, data and business logic.</p></article></div></section>
 <section class="home-example" aria-labelledby="home-discovery"><h2 id="home-discovery">Follow a connected discovery workflow</h2><p>Apply URL-backed filters, page through sample merchant cards and inspect empty, loading and recovery states. The example composes SearchFiltersBlock, MerchantListingBlock and MerchantCard.</p><div class="docs-actions"><Button as="a" href="/examples/discovery/">Try merchant discovery</Button><Button as="a" href="/examples/" variant="outline">All working examples</Button><a href="/docs/search-and-recovery/">Read the search and recovery pattern</a></div><p class="docs-note">A React example host with illustrative records. No merchant, authentication or payment service is included.</p></section>
 <section class="docs-section" aria-labelledby="home-blocks"><h2 id="home-blocks">Reuse an implemented Block</h2><div class="docs-grid">{blocks.map(block=><article class="docs-entry"><a href={`/blocks/${block.slug}/`}>{block.title}</a><p>{block.description}</p><p class="docs-note">{block.category} · Astro and React web · Experimental</p></article>)}</div></section>
 <section class="docs-section" aria-labelledby="home-frameworks"><h2 id="home-frameworks">Choose your web implementation</h2><div class="docs-grid"><article class="docs-entry"><h3>Astro source</h3><p>{supportCounts.astroComponents} component families and {supportCounts.astroBlocks} Blocks. Import the stylesheet once and render inside .dmf-ui.</p><CodeSnippet code={`---\nimport 'dmf-ui/styles.css';\nimport {Button} from 'dmf-ui/button';\n---\n<div class="dmf-ui">\n  <Button as="a" href="/catalog/">Open catalog</Button>\n</div>`} language="astro" title="Astro usage" wrap/><a href="/docs/installation/">Install an exact source archive</a></article><article class="docs-entry"><h3>React web alpha</h3><p>{supportCounts.reactComponents} component families and {supportCounts.reactBlocks} Blocks, with {supportCounts.reactExports} named exports. Coverage and native event APIs differ from Astro.</p><CodeSnippet code={`import '@dmf-ui/react/styles.css';\nimport {Button} from '@dmf-ui/react';\n\n<div className="dmf-ui">\n  <form action="/catalog/" method="get">\n    <Button type="submit">Open catalog</Button>\n  </form>\n</div>`} language="tsx" title="React usage" wrap/><a href="/docs/implementation-paths/">Check React setup and coverage</a></article></div><p class="docs-note">Private evaluation packages, not published npm releases. Responsive web does not imply native iOS, Android or desktop implementations.</p></section>
 <section class="docs-section" aria-labelledby="home-boundaries"><h2 id="home-boundaries">Shared appearance, explicit acceptance</h2><div class="docs-grid"><article class="docs-entry"><a href="/docs/presets/">Brand presets</a><p>Nova/Neutral is the default. Presets change shared semantic roles without duplicating components.</p></article><article class="docs-entry"><a href="/docs/accessibility/">Accessibility and contrast</a><p>Review tested behavior, known owner-selected CB/HUI contrast exceptions and manual checks that remain.</p></article><article class="docs-entry"><a href="https://github.com/dmfeisal/dmf-ui">Inspect the source on GitHub</a><p>Read the implementation, verification records and upstream notices. <a href="/docs/credits/">Credits and licenses</a>.</p></article></div></section>
</div>
</DocumentationLayout>
