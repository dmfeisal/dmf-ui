---
// Internal M15 measuring page: each case renders the DMF UI component. The shadcn-parity browser scenario builds
// the matching shadcn base-nova element next to it from the same case data and compares computed styles.
// Not linked, not indexed and not part of the packed archive.
import '../../styles/dmf-ui.css';
import '../../styles/shadcn-reference.css';
import data from '../../data/shadcn-parity-cases.json';
const modules=import.meta.glob('../../components/dmf-ui/*/index.ts',{eager:true}) as Record<string,Record<string,any>>;
const family=(slug:string)=>modules[`../../components/dmf-ui/${slug}/index.ts`];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>shadcn parity cases</title></head>
<body class="dmf-ui">
<main>
{data.cases.map(c=>{const Component=family(c.family)[c.component];return (
 <section data-parity-case={c.id} style="display:flex;gap:2rem;align-items:flex-start;padding:1rem">
  <div data-parity-side="dmf">{c.void?<Component {...c.dmf.props}/>:<Component {...c.dmf.props}>{c.text}</Component>}</div>
  <div data-parity-side="shadcn" class="style-nova"></div>
 </section>
);})}
</main>
<script type="application/json" id="parity-cases" set:html={JSON.stringify(data.cases)}></script>
</body>
</html>
